---
import OfferPage from "../components/OfferPage.astro";
import { offers } from "../data/offers";

export function getStaticPaths() {
  return offers.map((offer) => ({ params: { offer: offer.slug.fr }, props: { offer } }));
}
const { offer } = Astro.props;
---

<OfferPage lang="fr" offer={offer} />
