---
import ProjectCard from "./ProjectCard.astro";
import projects from "../data/projects.json";
import { categories } from "../data/overrides.json";
import { strings, homePath, langs, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "en" ? "fr" : "en";

const makers = [...new Set(projects.map((p) => p.maker))].sort();
// One section per category, in the order overrides.json lists them; anything
// uncategorised (a freshly tagged repo) lands in "More" until it gets one.
const sections = [...categories, { id: "more", label: { en: strings.en.more, fr: strings.fr.more } }]
  .map((c) => ({
    id: c.id,
    label: c.label[lang],
    projects: projects.filter((p) =>
      c.id === "more" ? !categories.some((k) => k.id === p.category) : p.category === c.id,
    ),
  }))
  .filter((s) => s.projects.length > 0);
const plural = (n: number) => (n === 1 ? t.projectOne : t.projectMany);
const canonical = new URL(homePath[lang], Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.en, Astro.site)} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    {projects[0]?.image && <meta property="og:image" content={new URL(projects[0].image, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="wrap">
      <div class="top">
        <p class="mark">The Vitrine</p>
        <a class="lang" href={homePath[other]} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>
      </div>
      <h1>{t.heading}</h1>
      <p class="lede">{t.lede}</p>
    </header>

    <main class="wrap">
      {projects.length === 0 ? (
        <p class="empty">{t.empty}</p>
      ) : (
        <>
          <nav class="filters" aria-label={t.filterLabel}>
            {makers.length > 1 && (
              <div class="group" data-filter="maker">
                <button type="button" aria-pressed="true" data-value="">{t.everyone}</button>
                {makers.map((m) => <button type="button" aria-pressed="false" data-value={m}>{m}</button>)}
              </div>
            )}
            {sections.length > 1 && (
              <div class="group" data-filter="category">
                <button type="button" aria-pressed="true" data-value="">{t.all}</button>
                {sections.map((s) => <button type="button" aria-pressed="false" data-value={s.id}>{s.label}</button>)}
              </div>
            )}
            <p class="count" aria-live="polite" data-one={t.projectOne} data-many={t.projectMany}>
              <span id="count">{projects.length}</span> <span id="count-word">{plural(projects.length)}</span>
            </p>
          </nav>
          {sections.map((s, si) => (
            <section class="category" data-category={s.id} aria-labelledby={`cat-${s.id}`}>
              <h2 id={`cat-${s.id}`}>
                {s.label} <span class="n">{s.projects.length}</span>
              </h2>
              <div class="grid">
                {s.projects.map((p, i) => <ProjectCard project={p} lang={lang} eager={si === 0 && i < 3} />)}
              </div>
            </section>
          ))}
        </>
      )}
    </main>

    <footer class="wrap">
      <p>
        {t.madeBy}{" "}
        <a href="https://www.antonyaddy.com" target="_blank" rel="noopener">Antony Addy</a>{" "}
        {t.and}{" "}
        <a href="https://julienb.vercel.app" target="_blank" rel="noopener">Julien Bourgois</a>.
      </p>
    </footer>

    <script>
      const state: Record<string, string> = { maker: "", category: "" };
      const sections = [...document.querySelectorAll<HTMLElement>("section.category")];
      const count = document.getElementById("count");
      const countWord = document.getElementById("count-word");
      const countBox = document.querySelector<HTMLElement>(".count");

      document.querySelectorAll<HTMLElement>(".filters .group").forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("button");
          if (!btn) return;
          group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          state[group.dataset.filter!] = btn.dataset.value ?? "";
          let shown = 0;
          for (const section of sections) {
            const inCategory = !state.category || section.dataset.category === state.category;
            let visible = 0;
            for (const card of section.querySelectorAll<HTMLElement>(".card")) {
              const ok = inCategory && (!state.maker || card.dataset.maker === state.maker);
              card.hidden = !ok;
              if (ok) visible++;
            }
            section.hidden = visible === 0;
            const n = section.querySelector(".n");
            if (n) n.textContent = String(visible);
            shown += visible;
          }
          if (count) count.textContent = String(shown);
          if (countWord && countBox) countWord.textContent = (shown === 1 ? countBox.dataset.one : countBox.dataset.many) ?? "";
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f3ee;
    --surface: #fffdf9;
    --ink: #1d1b18;
    --ink-soft: #5d574f;
    --line: #e4ded4;
    --muted-bg: #eee9e1;
    --accent: #a8431f;
    --shadow: rgb(60 40 20 / 0.35);
    --display: "Fraunces", Georgia, serif;
    --text: "Inter", system-ui, -apple-system, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161412;
      --surface: #1f1c19;
      --ink: #f2ede6;
      --ink-soft: #b3aca2;
      --line: #34302b;
      --muted-bg: #2a2622;
      --accent: #ec8a62;
      --shadow: rgb(0 0 0 / 0.7);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 640px) { .wrap { padding: 0 2rem; } }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<style>
  header { padding-top: 2rem; padding-bottom: 2.5rem; }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .mark {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--accent);
    margin: 0;
  }
  .lang {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 99px;
  }
  .lang:hover { border-color: var(--ink-soft); color: var(--accent); }
  h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 14ch;
    margin: 0;
  }
  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 40ch; margin: 1.25rem 0 0; }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    padding: 1rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .group { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .group button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.4rem 0.85rem;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .group button:hover { color: var(--ink); border-color: var(--ink-soft); }
  .group button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .count { margin: 0 0 0 auto; font-size: 0.875rem; color: var(--ink-soft); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 1.5rem;
  }
  .category { margin-top: 2.5rem; }
  .category:first-of-type { margin-top: 0.5rem; }
  .category h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0 0 1.1rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .category h2 .n { font-family: var(--text); font-size: 0.9rem; font-weight: 500; color: var(--ink-soft); }
  .empty { padding: 3rem 0; color: var(--ink-soft); }
  footer { padding-top: 4rem; padding-bottom: 3rem; color: var(--ink-soft); font-size: 0.9rem; }
  footer a { color: var(--ink); text-underline-offset: 3px; }
  footer a:hover { color: var(--accent); }
</style>
