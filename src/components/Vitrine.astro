---
import ProjectCard from "./ProjectCard.astro";
import Hero from "./Hero.astro";
import projects from "../data/projects.json";
import { categories } from "../data/overrides.json";
import { strings, homePath, legalPath, langs, type Lang } from "../i18n";
import { spans } from "../wide";
import "../styles/motion.css";
import { Font } from "astro:assets";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];

const makers = [...new Set(projects.map((p) => p.maker))].sort();
// One section per category, in the order overrides.json lists them; anything
// uncategorised (a freshly tagged repo) lands in "More" until it gets one.
const sections = [...categories, { id: "more", label: { en: strings.en.more, fr: strings.fr.more } }]
  .map((c) => ({
    id: c.id,
    label: c.label[lang],
    projects: projects.filter((p) =>
      c.id === "more" ? !categories.some((k) => k.id === p.category) : p.category === c.id,
    ),
  }))
  .filter((s) => s.projects.length > 0)
  .map((s) => ({ ...s, ...spans(s.projects.length) }));
const pad = (n: number) => String(n).padStart(2, "0");
const plural = (n: number) => (n === 1 ? t.projectOne : t.projectMany);
const canonical = new URL(homePath[lang], Astro.site);
const ogImage = new URL(`/og/${lang}.jpg`, Astro.site);
// Who we are, for search engines: the studio and its two makers.
const ld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The Vitrine",
  url: canonical.href,
  description: t.description,
  image: ogImage.href,
  knowsLanguage: ["fr", "en"],
  founder: [
    { "@type": "Person", name: "Antony Addy", url: "https://www.antonyaddy.com" },
    { "@type": "Person", name: "Julien Bourgois", url: "https://julienb.vercel.app" },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Reveals only hide content once we know scripts run. Arriving through a
      // page transition (the language switch) skips the hero's intro.
      document.documentElement.classList.add("js");
      // Safety net: if the main script never runs (blocked or failed to load),
      // show everything rather than leave content hidden.
      setTimeout(function () { if (!window.__vitrine) document.documentElement.classList.add("reveal-all"); }, 3000);
      addEventListener("pagereveal", (e) => e.viewTransition && document.documentElement.classList.add("no-intro"));
      // Choosing a language by hand is remembered for a year; it overrides the
      // browser-language redirect on / (see vercel.json).
      addEventListener("click", (e) => {
        const a = e.target.closest && e.target.closest("a.lang[hreflang]");
        if (a) document.cookie = "lang=" + a.hreflang + "; path=/; max-age=31536000; SameSite=Lax";
      });
    </script>
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.fr, Astro.site)} />
    <meta name="theme-color" content="#081227" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Vitrine" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:locale:alternate" content={lang === "fr" ? "en_GB" : "fr_FR"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <Font cssVariable="--font-fraunces" preload={[{ style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-inter" preload={[{ subset: "latin" }]} />
  </head>
  <body>
    <Hero lang={lang} projects={projects} total={projects.length} />

    <main class="wrap" id="work">
      {projects.length === 0 ? (
        <p class="empty">{t.empty}</p>
      ) : (
        <>
          <div class="sentinel" aria-hidden="true"></div>
          <nav class="filters" aria-label={t.filterLabel}>
            <div class="filters-top">
              {makers.length > 1 && (
                <div class="group seg" data-filter="maker">
                  <span class="ind" aria-hidden="true"></span>
                  <button type="button" aria-pressed="true" data-value="">{t.everyone}</button>
                  {makers.map((m) => <button type="button" aria-pressed="false" data-value={m}>{m}</button>)}
                </div>
              )}
              <div class="bar-end">
                <p class="count" aria-live="polite" data-one={t.projectOne} data-many={t.projectMany}>
                  <span id="count">{projects.length}</span> <span id="count-word">{plural(projects.length)}</span>
                </p>
                <a class="bar-cta" href="#contact"><span class="long">{t.heroCta2}</span><span class="short">{t.barCta}</span> <span aria-hidden="true">↓</span></a>
              </div>
            </div>
            {sections.length > 1 && (
              <div class="group tabs" data-filter="category">
                <span class="ind" aria-hidden="true"></span>
                <button type="button" aria-pressed="true" data-value="">{t.all}</button>
                {sections.map((s) => <button type="button" aria-pressed="false" data-value={s.id}>{s.label}</button>)}
              </div>
            )}
          </nav>
          {sections.map((s, si) => (
            <section class="category" data-category={s.id} aria-labelledby={`cat-${s.id}`}>
              <h2 id={`cat-${s.id}`} data-reveal="heading">
                {s.label} <span class="rule" aria-hidden="true"></span><span class="n">{pad(s.projects.length)}</span>
              </h2>
              <div class="grid">
                {s.projects.map((p, i) => <ProjectCard project={p} lang={lang} eager={si === 0 && i < 3} wide3={s.w3.has(i)} wide2={s.w2.has(i)} />)}
              </div>
            </section>
          ))}
        </>
      )}
    </main>

    <footer class="contact" id="contact">
      <div class="sill horizon" data-reveal="line" aria-hidden="true"></div>
      <div class="wrap">
      <h2 data-reveal="heading">{t.contactLead} <em>{t.contactAccent}</em>{t.contactTail}</h2>
      <p class="contact-lede" data-reveal>{t.contactLede}</p>
      <div class="people">
        <a class="person" data-reveal href="https://www.antonyaddy.com/contact?sujet=sites" target="_blank" rel="noopener">
          <strong>Antony Addy</strong>
          <span>{t.contactAntony}</span>
          <em>{t.contactCta} <span aria-hidden="true">↗</span></em>
        </a>
        <a class="person" data-reveal href="https://julienb.vercel.app/#contact" target="_blank" rel="noopener">
          <strong>Julien Bourgois</strong>
          <span>{t.contactJulien}</span>
          <em>{t.contactCta} <span aria-hidden="true">↗</span></em>
        </a>
      </div>
      <p class="small" data-reveal>
        <span>The Vitrine · {t.madeBy} Antony Addy {t.and} Julien Bourgois</span>
        <a href={legalPath[lang]}>{t.legalLink}</a>
      </p>
      </div>
    </footer>

    <script>
      import { spans } from "../wide";
      (window as any).__vitrine = true;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      const root = document.documentElement;

      // ---- Scroll reveals: each batch that enters together staggers by --i.
      const io = new IntersectionObserver(
        (entries) => {
          let i = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.setProperty("--i", String(Math.min(i++, 5)));
            el.classList.add("in");
            io.unobserve(el);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
      );
      const reveal = document.querySelectorAll<HTMLElement>("[data-reveal]");
      reveal.forEach((el) => {
        io.observe(el);
        // Once settled, hand the element back to its own hover transitions.
        el.addEventListener("transitionend", function done(ev) {
          if (ev.target !== el || !el.classList.contains("in")) return;
          el.removeAttribute("data-reveal");
          el.style.removeProperty("--i");
          el.removeEventListener("transitionend", done);
        });
      });
      const revealAll = () => reveal.forEach((el) => el.classList.add("in"));

      // ---- Screenshots fade up as they arrive instead of painting in strips.
      document.querySelectorAll<HTMLImageElement>(".shot img").forEach((img) => {
        if (img.complete && img.naturalWidth) img.classList.add("loaded");
        else img.addEventListener("load", () => img.classList.add("loaded"), { once: true });
        // A screenshot that fails to load leaves the empty frame, not a broken-image icon.
        img.addEventListener("error", () => img.remove(), { once: true });
      });

      // ---- The filter bar pins under the top edge; it gains a shadow once it does.
      const filters = document.querySelector<HTMLElement>(".filters");
      const sentinel = document.querySelector(".sentinel");
      if (filters && sentinel) {
        new IntersectionObserver(([e]) => filters.classList.toggle("stuck", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(sentinel);
      }

      // ---- Filtering: the results dim, the view returns to the top of the list,
      // and the new set rises in reading order. Nothing travels across the screen.
      const state: Record<string, string> = { maker: "", category: "" };
      const sections = [...document.querySelectorAll<HTMLElement>("section.category")];
      const count = document.getElementById("count");
      const countWord = document.getElementById("count-word");
      const countBox = document.querySelector<HTMLElement>(".count");

      const apply = () => {
        let shown = 0;
        for (const section of sections) {
          const inCategory = !state.category || section.dataset.category === state.category;
          const cards = [...section.querySelectorAll<HTMLElement>(".card")];
          const shownHere: HTMLElement[] = [];
          for (const card of cards) {
            const ok = inCategory && (!state.maker || card.dataset.maker === state.maker);
            card.hidden = !ok;
            if (ok) shownHere.push(card);
          }
          // Re-pick the wide cards so every row of what's left still closes.
          const { w3, w2 } = spans(shownHere.length);
          cards.forEach((c) => { c.removeAttribute("data-w3"); c.removeAttribute("data-w2"); });
          shownHere.forEach((c, i) => { c.toggleAttribute("data-w3", w3.has(i)); c.toggleAttribute("data-w2", w2.has(i)); });
          const visible = shownHere.length;
          section.hidden = visible === 0;
          const n = section.querySelector(".n");
          if (n) n.textContent = String(visible).padStart(2, "0");
          shown += visible;
        }
        if (count && count.textContent !== String(shown)) {
          count.textContent = String(shown);
          count.classList.remove("tick");
          void count.offsetWidth;
          count.classList.add("tick");
        }
        if (countWord && countBox) countWord.textContent = (shown === 1 ? countBox.dataset.one : countBox.dataset.many) ?? "";
      };

      const css = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
      const ms = (name: string) => parseFloat(css(name)) || 0;
      let swapping: Animation | null = null;
      const swap = async () => {
        swapping?.cancel();
        const out = sections.map((s) =>
          s.animate([{ opacity: 1 }, { opacity: 0 }], { duration: ms("--dur-micro"), easing: css("--ease-leave"), fill: "forwards" }),
        );
        swapping = out[0] ?? null;
        await Promise.allSettled(out.map((a) => a.finished));
        apply();
        out.forEach((a) => a.cancel());
        // Bring the top of the results back under the pinned bar if we had scrolled past it.
        const bar = filters?.offsetHeight ?? 0;
        const first = sections.find((s) => !s.hidden);
        if (first && first.getBoundingClientRect().top < bar) {
          scrollTo({ top: scrollY + first.getBoundingClientRect().top - bar - 16, behavior: "instant" as ScrollBehavior });
        }
        let i = 0;
        for (const el of document.querySelectorAll<HTMLElement>("section.category:not([hidden]) h2, .card:not([hidden])")) {
          const r = el.getBoundingClientRect();
          if (r.top > innerHeight || r.bottom < 0) continue;
          el.animate(
            [{ opacity: 0, transform: "translateY(16px)" }, { opacity: 1, transform: "none" }],
            { duration: ms("--dur-reveal"), delay: Math.min(i++, 6) * ms("--stagger"), easing: css("--ease-arrive"), fill: "backwards" },
          );
        }
      };

      // ---- Sliding indicators: the maker switch's thumb and the tabs' underline
      // glide to the chosen button. Placed instantly on load and on resize.
      const groups = [...document.querySelectorAll<HTMLElement>(".filters .group")];
      const place = (group: HTMLElement, glide: boolean) => {
        const ind = group.querySelector<HTMLElement>(".ind");
        const on = group.querySelector<HTMLElement>('button[aria-pressed="true"]');
        if (!ind || !on) return;
        if (!glide) ind.style.transition = "none";
        ind.style.setProperty("--x", `${on.offsetLeft}px`);
        ind.style.setProperty("--w", `${on.offsetWidth}px`);
        if (!glide) { void ind.offsetWidth; ind.style.transition = ""; }
      };
      const placeAll = () => groups.forEach((g) => place(g, false));
      groups.forEach((g) => g.classList.add("has-ind"));
      placeAll();
      document.fonts?.ready.then(placeAll);
      if ("ResizeObserver" in window) groups.forEach((g) => new ResizeObserver(() => place(g, false)).observe(g));

      groups.forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("button");
          if (!btn || btn.getAttribute("aria-pressed") === "true") return;
          group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          place(group, true);
          btn.scrollIntoView({ block: "nearest", inline: "nearest", behavior: reduced.matches ? "auto" : "smooth" });
          state[group.dataset.filter!] = btn.dataset.value ?? "";
          revealAll();
          if (reduced.matches) return apply();
          swap();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f3ee;
    --surface: #fffdf9;
    --ink: #1d1b18;
    --ink-soft: #5d574f;
    --line: #e4ded4;
    --muted-bg: #eee9e1;
    --accent: #a8431f;
    --brand: #1f5fbf;
    --shadow: rgb(60 40 20 / 0.35);
    --chrome: #efe9df;
    /* Lamp light: the warm edge and glow a window gets when you look at it. */
    --lit-edge: #e2b48c;
    --lit-glow: rgb(168 67 31 / 0.45);
    --display: var(--font-fraunces);
    --text: var(--font-inter);
    /* Night: the hero and the contact section, the two ends of the visit. */
    --night: #081227;
    --night-2: #10234d;
    --lamp: #ffc27d;
    --lamp-hot: #ffe2b8;
    --text-hi: #f6f2ea;
    --text-lo: #b4c0dc;
    --blue: #79adff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      /* In dark mode the whole visit stays at blue hour, lit by the same lamp. */
      --bg: #0a1329;
      --surface: #101b36;
      --ink: #f2efe8;
      --ink-soft: #a7b1ca;
      --line: #22305a;
      --muted-bg: #14203f;
      --chrome: #17244a;
      --accent: #ffb27a;
      --brand: #8ab6ff;
      --shadow: rgb(0 0 0 / 0.7);
      --lit-edge: rgb(255 194 125 / 0.55);
      --lit-glow: rgb(255 178 102 / 0.4);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    overflow-x: hidden;
    overflow-x: clip;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 640px) { .wrap { padding: 0 2rem; } }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  /* Focus rings take the lamp colour on night surfaces, where the paper accent is too dark to see. */
  :focus-visible { outline: 2px solid var(--focus, var(--accent)); outline-offset: 2px; }
  .hero, .contact { --focus: var(--lamp); }
  /* Keyboard focus never lands hidden under the pinned filter bar. */
  main :is(a, button) { scroll-margin-top: 9rem; }
</style>

<style>
  /* Light from the window spills onto the paper just below the hero's sill. */
  #work { position: relative; padding-top: 3rem; }
  #work::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 240px;
    transform: translateX(-50%);
    background: radial-gradient(45% 100% at 50% 0, rgb(255 178 102 / 0.16), transparent 100%);
    pointer-events: none;
    z-index: -1;
  }
  .sentinel { height: 1px; }
  /* Pinned filter bar: a maker switch and the count on top, category tabs below
     sitting on a hairline. Full-bleed paper and a shadow appear once it pins. */
  .filters {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 0.9rem;
    margin-bottom: 1.75rem;
    transition: box-shadow var(--dur-short) var(--ease-hover);
  }
  /* Paper goes behind the bar only once it pins, so the window's light spill
     above it isn't cut off while it sits in place. */
  .filters.stuck {
    background: var(--bg);
    border-image: linear-gradient(var(--bg) 0 0) fill 0 / / 0 100vw;
    box-shadow: 0 18px 24px -24px var(--shadow);
  }
  .filters-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .group { position: relative; display: flex; }
  .group button {
    position: relative;
    z-index: 1;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-hover);
  }
  .group button:hover, .group button[aria-pressed="true"] { color: var(--ink); }
  /* The indicator is positioned by script from the chosen button (--x, --w).
     Its width animates too: one small, absolutely placed element, so it stays cheap. */
  .ind {
    position: absolute;
    left: 0;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur-base) var(--ease-move),
      width var(--dur-base) var(--ease-move);
  }
  .has-ind .ind { opacity: 1; }

  /* Maker: a segmented switch. A raised thumb slides under the chosen name. */
  .seg {
    padding: 3px;
    border-radius: 99px;
    background: var(--muted-bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .seg button { padding: 0.42rem 1.05rem; border-radius: 99px; }
  .seg .ind {
    top: 3px;
    bottom: 3px;
    border-radius: 99px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line), 0 2px 6px -2px var(--shadow);
  }
  /* Without script the chosen segment simply fills in. */
  .seg:not(.has-ind) button[aria-pressed="true"] { background: var(--surface); box-shadow: 0 0 0 1px var(--line); }

  /* Categories: quiet text tabs on a hairline; an accent underline marks the choice. */
  .tabs { gap: 1.75rem; box-shadow: inset 0 -1px 0 var(--line); }
  .tabs button { padding: 0.5rem 0 0.8rem; font-size: 0.9rem; }
  .tabs .ind { bottom: 0; height: 2px; border-radius: 2px; background: var(--accent); }
  .tabs:not(.has-ind) button[aria-pressed="true"] { box-shadow: inset 0 -2px 0 var(--accent); }

  .count { margin: 0; font-size: 0.875rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .bar-end { display: flex; align-items: center; gap: 1rem; }
  /* Once the bar pins, a way out to the contact section rides along with it. */
  .bar-cta {
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0 1rem;
    border-radius: 99px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    color: #1a0f04;
    background: linear-gradient(180deg, var(--lamp-hot), var(--lamp));
    box-shadow: 0 6px 18px -8px rgb(255 178 102 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.6);
    display: none;
  }
  /* It arrives with a short drop-in once the bar pins and leaves at once when it unpins. */
  .filters.stuck .bar-cta { display: inline-flex; animation: cta-in var(--dur-short) var(--ease-arrive); }
  @keyframes cta-in { from { opacity: 0; transform: translateY(-4px); } }
  .bar-cta .short { display: none; }

  /* On small screens the tabs scroll sideways instead of stacking into a wall. */
  @media (max-width: 720px) {
    .filters { gap: 0.6rem; padding-top: 0.75rem; }
    .tabs {
      gap: 1.4rem;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -1rem;
      padding-inline: 1rem;
      mask-image: linear-gradient(90deg, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent);
    }
    .tabs::-webkit-scrollbar { display: none; }
    /* Phones: no room for both, so the count gives way to a short "Contact" once pinned. */
    .filters.stuck .count { display: none; }
    .bar-cta { min-height: 32px; padding: 0 0.85rem; font-size: 0.8rem; }
    .bar-cta .long { display: none; }
    .bar-cta .short { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ind { transition: none; }
    .filters.stuck .bar-cta { animation: none; }
  }
  /* Fixed column counts, so src/wide.ts can close every row (breakpoints match ProjectCard). */
  .grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .category { margin-top: 4rem; }
  .category:first-of-type { margin-top: 1rem; }
  /* Chapter headings: the name, a hairline running to the edge, the count at the end. */
  .category h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: -0.015em;
    margin: 0 0 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .category h2 .rule { flex: 1; height: 1px; background: var(--line); align-self: center; transform: translateY(0.15em); }
  .category h2 .n {
    font-family: var(--text);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .empty { padding: 3rem 0; color: var(--ink-soft); }
