---
import ProjectCard from "./ProjectCard.astro";
import ClassicHero from "./Hero.astro";
import ShowcaseHero from "./HeroShowcase.astro";
import projects from "../data/projects.json";
import { categories } from "../data/overrides.json";
import { strings, homePath, legalPath, blogPath, questionnairePath, contactPath, langs, langNames, tr, hasBlog as langHasBlog, type Lang } from "../i18n";
import { feedPath } from "../rss";
import { postsFor, isPublished } from "../blog";
import { spans } from "../wide";
import { priceFrom, timescale, profiles, whatsapp, missingBusinessFields } from "../data/business";
import { faq, missingFaqAnswers } from "../data/faq";
import "../styles/motion.css";
import { Font } from "astro:assets";

interface Props {
  lang: Lang;
  classicHero?: boolean;
  noindex?: boolean;
}
const { lang, classicHero = false, noindex = false } = Astro.props;
const Hero = classicHero ? ClassicHero : ShowcaseHero;
const t = strings[lang];

// One section per category, in the order overrides.json lists them; anything
// uncategorised (a freshly tagged repo) lands in "More" until it gets one.
const sections = [...categories, { id: "more", label: { en: strings.en.more, fr: strings.fr.more, it: strings.it.more } }]
  .map((c) => ({
    id: c.id,
    label: (c.label as Record<Lang, string>)[lang],
    projects: projects.filter((p) =>
      c.id === "more" ? !categories.some((k) => k.id === p.category) : p.category === c.id,
    ),
  }))
  .filter((s) => s.projects.length > 0)
  .map((s) => ({ ...s, ...spans(s.projects.length) }));
const pad = (n: number) => String(n).padStart(2, "0");
const plural = (n: number) => (n === 1 ? t.projectOne : t.projectMany);
const canonical = new URL(homePath[lang], Astro.site);
const ogImage = new URL(`/og/${lang}.jpg`, Astro.site);
const description = t.description.replace("{n}", String(projects.length));
const abs = (path: string) => new URL(path, Astro.site).href;

// Placeholders in src/data/business.ts: lines without data stay off the page.
const missing = missingBusinessFields();
if (missing.length) console.warn(`[business] Placeholders left empty in src/data/business.ts: ${missing.join(", ")}`);
const priceLine =
  priceFrom !== null && timescale
    ? t.servicesPrice.replace("{timescale}", timescale[lang]).replace("{price}", priceFrom.toLocaleString(tr(lang, { fr: "fr-FR", en: "en-GB", it: "it-IT" })))
    : null;
// FAQ: only questions with an answer are shown (the rest are placeholders).
const faqShown = faq.filter((f) => f.a !== null).map((f) => ({ id: f.id, q: f.q[lang], a: f.a![lang] }));
const faqMissing = missingFaqAnswers();
// The blog is linked from the homepage once it has at least one published article.
const hasBlog = langHasBlog(lang) && (await postsFor(lang)).some(isPublished);
if (faqMissing.length) console.warn(`[faq] Questions hidden until answered in src/data/faq.ts: ${faqMissing.join(", ")}`);
const services = [
  [t.servicesWhoTitle, t.servicesWho],
  [t.servicesWhatTitle, t.servicesWhat],
  [t.servicesWhereTitle, t.servicesWhere],
  [t.servicesHowTitle, t.servicesHow],
];

// Structured data: the studio and its two founders, the site, the service it offers
// and the portfolio, linked by @id so search engines see one connected entity.
const id = { org: abs("/#organization"), site: abs(`${homePath[lang]}#website`), antony: abs("/#antony"), julien: abs("/#julien") };
const areaServed = [
  { "@type": "AdministrativeArea", name: "Var" },
  { "@type": "AdministrativeArea", name: "Alpes-Maritimes" },
  { "@type": "Country", name: "United Kingdom" },
  { "@type": "Country", name: "Italy" },
];
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": id.org,
      name: "The Vitrine",
      url: abs(homePath.fr),
      logo: { "@type": "ImageObject", url: abs("/icon-512.png"), width: 512, height: 512 },
      image: ogImage.href,
      description,
      knowsLanguage: ["fr", "en", "it"],
      areaServed,
      founder: [{ "@id": id.antony }, { "@id": id.julien }],
      ...(profiles.length ? { sameAs: profiles } : {}),
      makesOffer: {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: t.serviceName, serviceType: t.serviceName, areaServed, provider: { "@id": id.org } },
        ...(priceFrom !== null
          ? { priceSpecification: { "@type": "PriceSpecification", minPrice: priceFrom, priceCurrency: "EUR" } }
          : {}),
      },
    },
    { "@type": "Person", "@id": id.antony, name: "Antony Addy", url: "https://www.antonyaddy.com", sameAs: ["https://www.antonyaddy.com"], worksFor: { "@id": id.org } },
    { "@type": "Person", "@id": id.julien, name: "Julien Bourgois", url: "https://julienb.vercel.app", sameAs: ["https://julienb.vercel.app"], worksFor: { "@id": id.org } },
    {
      "@type": "WebSite",
      "@id": id.site,
      url: canonical.href,
      name: "The Vitrine",
      inLanguage: lang,
      publisher: { "@id": id.org },
    },
    {
      "@type": "FAQPage",
      "@id": abs(`${homePath[lang]}#faq`),
      inLanguage: lang,
      mainEntity: faqShown.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "ItemList",
      name: t.portfolioName,
      numberOfItems: projects.length,
      itemListElement: projects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "CreativeWork",
          name: p.title,
          ...(p.url ? { url: p.url } : {}),
          ...(p.description[lang as "en" | "fr"] ? { description: p.description[lang as "en" | "fr"] } : {}),
          ...(p.image ? { image: abs(p.image) } : {}),
          creator: { "@id": id.org },
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Reveals only hide content once we know scripts run. Arriving through a
      // page transition (the language switch) skips the hero's intro.
      document.documentElement.classList.add("js");
      // Safety net: if the main script never runs (blocked or failed to load),
      // show everything rather than leave content hidden.
      setTimeout(function () { if (!window.__vitrine) document.documentElement.classList.add("reveal-all"); }, 3000);
      addEventListener("pagereveal", (e) => e.viewTransition && document.documentElement.classList.add("no-intro"));
    </script>
    <title>{t.title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath.fr, Astro.site)} />
    <meta name="theme-color" content="#081227" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Vitrine" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={langNames[lang].locale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langNames[l].locale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {langHasBlog(lang) && <link rel="alternate" type="application/rss+xml" title={`${t.blogHeading} · The Vitrine`} href={feedPath[lang]} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <Font cssVariable="--font-fraunces" preload={[{ style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-inter" preload={[{ subset: "latin" }]} />
  </head>
  <body>
    <Hero lang={lang} projects={projects} total={projects.length} />

    <main id="main-content" tabindex="-1" class="wrap">
      <div id="work">
      {projects.length === 0 ? (
        <p class="empty">{t.empty}</p>
      ) : (
        <>
          <div class="sentinel" aria-hidden="true"></div>
          <nav class="filters" aria-label={t.filterLabel}>
            <div class="filters-top">
              <div class="bar-end">
                <p class="count" aria-live="polite" data-one={t.projectOne} data-many={t.projectMany} data-selected={tr(lang, { fr: "projets sélectionnés", en: "selected projects", it: "progetti selezionati" })}>
                  <span id="count">{projects.length}</span> <span id="count-word">{plural(projects.length)}</span>
                </p>
                <a class="bar-cta" href={questionnairePath[lang]}><span class="long">{t.heroCta2}</span><span class="short">{t.barCta}</span> <span aria-hidden="true">↓</span></a>
              </div>
            </div>
            {sections.length > 1 && (
              <div class="group tabs" data-filter="category">
                <span class="ind" aria-hidden="true"></span>
                <button type="button" aria-pressed="true" data-value="">{t.all}</button>
                {sections.map((s) => <button type="button" aria-pressed="false" data-value={s.id}>{s.label}</button>)}
              </div>
            )}
          </nav>
          <div class="empty" id="filter-empty" hidden role="status">
            <p>{tr(lang, { fr: "Aucune réalisation ne correspond à ces filtres.", en: "No projects match these filters.", it: "Nessun progetto corrisponde a questi filtri." })}</p>
            <button type="button" id="filter-reset">{tr(lang, { fr: "Voir toutes les réalisations", en: "Show all projects", it: "Mostra tutti i progetti" })}</button>
          </div>
          {sections.map((s, si) => (
            <section class="category" data-category={s.id} aria-labelledby={`cat-${s.id}`}>
              <div class="cat-head" data-reveal="heading">
                <h2 id={`cat-${s.id}`}>{s.label}</h2>
                <span class="rule" aria-hidden="true"></span>
                <span class="n">{pad(s.projects.length)}</span>
              </div>
              <div class="grid">
                {s.projects.map((p, i) => <ProjectCard project={p} lang={lang} eager={si === 0 && i < 3} wide3={s.w3.has(i)} wide2={s.w2.has(i)} />)}
              </div>
            </section>
          ))}
          <div class="work-more" hidden id="work-more"><p>{tr(lang, { fr: "Une sélection de nos réalisations. Explorez tout le portfolio ou choisissez une catégorie.", en: "A selection of our work. Explore the full portfolio or choose a category.", it: "Una selezione dei nostri progetti. Esplora tutto il portfolio o scegli una categoria." })}</p><button type="button" id="work-expand">{tr(lang, { fr: `Voir les ${projects.length} réalisations`, en: `See all ${projects.length} projects`, it: `Vedi tutti i ${projects.length} progetti` })}</button></div>
        </>
      )}
      </div>
      {/* The filter bar pins only within #work, so it lets go before these. */}
      <section class="services" id="services" aria-labelledby="services-title">
        <h2 id="services-title" data-reveal="heading">{t.servicesHeading}</h2>
        <p class="services-lede" data-reveal>{t.servicesLede}</p>
        <div class="services-grid">
          {services.map(([title, text]) => (
            <div class="service" data-reveal>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
        {priceLine && <p class="services-price" data-reveal>{priceLine}</p>}
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title" data-reveal="heading">{t.faqHeading}</h2>
        <div class="faq-list">
          {faqShown.map((f) => (
            <details class="qa" data-reveal>
              <summary><h3>{f.q}</h3><span class="sign" aria-hidden="true"></span></summary>
              <div class="answer"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="contact" id="contact">
      <div class="sill horizon" data-reveal="line" aria-hidden="true"></div>
      <div class="wrap">
      <h2 data-reveal="heading">{t.contactLead} <em>{t.contactAccent}</em>{t.contactTail}</h2>
      <p class="contact-lede" data-reveal>{t.contactLede}</p>
      <div class="quote-cta" data-reveal>
        <a class="quote-btn" href={questionnairePath[lang]}>{t.quoteCta} <span aria-hidden="true">→</span></a>
        <a class="msg-btn" href={contactPath[lang]}>{t.msgCta}</a>
        <p>{t.quoteNote}</p>
      </div>
      <div class="people">
        <div class="person" data-reveal>
          <picture class="portrait">
            <source srcset="/people/antony-portrait.webp" type="image/webp" />
            <img src="/people/antony-portrait.jpg" alt="Antony Addy" width="480" height="600" loading="lazy" decoding="async" />
          </picture>
          <div class="person-text">
          <strong>Antony Addy</strong>
          <span class="role">{t.contactRole}</span>
          <div class="person-actions">
            <a class="person-link" href={contactPath[lang]}>{t.contactCta} <span aria-hidden="true">→</span></a>
            {/* The number is not in the page: the link is built on tap from the encoded
                value (src/protect.ts). Without JavaScript it opens our contact page. */}
            <a class="wa" href={contactPath[lang]} data-wa={whatsapp.antony} data-text={t.waText.replace("{name}", "Antony")} target="_blank" rel="nofollow noopener" aria-label={t.waAria.replace("{name}", "Antony")}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
              {t.waLabel}
            </a>
          </div>
          </div>
        </div>
        <div class="person" data-reveal>
          <picture class="portrait">
            <source srcset="/people/julien-portrait.webp" type="image/webp" />
            <img src="/people/julien-portrait.jpg" alt="Julien Bourgois" width="480" height="600" loading="lazy" decoding="async" />
          </picture>
          <div class="person-text">
          <strong>Julien Bourgois</strong>
          <span class="role">{t.contactRole}</span>
          <div class="person-actions">
            <a class="person-link" href={contactPath[lang]}>{t.contactCta} <span aria-hidden="true">→</span></a>
            <a class="wa" href={contactPath[lang]} data-wa={whatsapp.julien} data-text={t.waText.replace("{name}", "Julien")} target="_blank" rel="nofollow noopener" aria-label={t.waAria.replace("{name}", "Julien")}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
              {t.waLabel}
            </a>
          </div>
          </div>
        </div>
      </div>
      <p class="small" data-reveal>
        <span>The Vitrine · {t.madeBy} Antony Addy {t.and} Julien Bourgois</span>
        <span class="footer-links">
          {hasBlog && langHasBlog(lang) && <a href={blogPath[lang]}>{t.blogName}</a>}
          <a href={legalPath[lang]}>{t.legalLink}</a>
        </span>
      </p>
      </div>
    </footer>

    <script>
      import { spans } from "../wide";
      import { decodeNumber } from "../protect";
      import { initSiteMotion, revealAll } from "../motion";
      initSiteMotion();
      // WhatsApp: build the wa.me link only when a visitor taps (the number is not in the page).
      document.querySelectorAll<HTMLAnchorElement>("a[data-wa]").forEach((a) =>
        a.addEventListener("click", (e) => {
          e.preventDefault();
          const text = a.dataset.text ? `?text=${encodeURIComponent(a.dataset.text)}` : "";
          window.open(`https://wa.me/${decodeNumber(a.dataset.wa!)}${text}`, "_blank", "noopener");
        }),
      );
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      const root = document.documentElement;

      // ---- Screenshots fade up as they arrive instead of painting in strips.
      document.querySelectorAll<HTMLImageElement>(".shot img").forEach((img) => {
        if (img.complete && img.naturalWidth) img.classList.add("loaded");
        else img.addEventListener("load", () => img.classList.add("loaded"), { once: true });
        // A screenshot that fails to load leaves the empty frame, not a broken-image icon.
        img.addEventListener("error", () => img.remove(), { once: true });
      });

      // ---- The filter bar pins under the top edge; it gains a shadow once it does.
      const filters = document.querySelector<HTMLElement>(".filters");
      const sentinel = document.querySelector(".sentinel");
      if (filters && sentinel) {
        new IntersectionObserver(([e]) => filters.classList.toggle("stuck", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(sentinel);
      }

      // ---- Filtering: the results dim, the view returns to the top of the list,
      // and the new set rises in reading order. Nothing travels across the screen.
      const state: Record<string, string> = { category: "" };
      const sections = [...document.querySelectorAll<HTMLElement>("section.category")];
      const count = document.getElementById("count");
      const countWord = document.getElementById("count-word");
      const countBox = document.querySelector<HTMLElement>(".count");

      let expanded = false;
      const featured = new Set<HTMLElement>();
      sections.forEach(section => { const card = section.querySelector<HTMLElement>(".card"); if (card) featured.add(card); });
      document.querySelectorAll<HTMLElement>("#work .card").forEach(card => { if(featured.size < 8) featured.add(card); });
      const more = document.getElementById("work-more")!;
      const apply = () => {
        let shown = 0;
        for (const section of sections) {
          const inCategory = !state.category || section.dataset.category === state.category;
          const cards = [...section.querySelectorAll<HTMLElement>(".card")];
          const shownHere: HTMLElement[] = [];
          for (const card of cards) {
            const ok = inCategory && (expanded || featured.has(card));
            card.hidden = !ok;
            if (ok) shownHere.push(card);
          }
          // Re-pick the wide cards so every row of what's left still closes.
          const { w3, w2 } = spans(shownHere.length);
          cards.forEach((c) => { c.removeAttribute("data-w3"); c.removeAttribute("data-w2"); });
          shownHere.forEach((c, i) => { c.toggleAttribute("data-w3", w3.has(i)); c.toggleAttribute("data-w2", w2.has(i)); });
          const visible = shownHere.length;
          section.hidden = visible === 0;
          const n = section.querySelector(".n");
          if (n) n.textContent = String(visible).padStart(2, "0");
          shown += visible;
        }
        more.hidden = expanded;
        document.getElementById("filter-empty")!.hidden = shown !== 0;
        if (count && count.textContent !== String(shown)) {
          count.textContent = String(shown);
          count.classList.remove("tick");
          void count.offsetWidth;
          count.classList.add("tick");
        }
        if (countWord && countBox) countWord.textContent = !expanded ? countBox.dataset.selected : (shown === 1 ? countBox.dataset.one : countBox.dataset.many) ?? "";
      };

      const css = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
      let filterAnimations: Animation[] = [];
      const swap = () => {
        filterAnimations.forEach(animation => animation.cancel());
        filterAnimations = [];
        const cards = [...document.querySelectorAll<HTMLElement>(".card")];
        const before = new Map(cards.filter(card => !card.hidden).map(card => {
          const r = card.getBoundingClientRect();
          return [card,{left:r.left + scrollX,top:r.top + scrollY}];
        }));
        apply();
        const bar = (filters?.offsetHeight ?? 0) + (document.querySelector("[data-site-header]")?.getBoundingClientRect().height ?? 0);
        const first = sections.find(section => !section.hidden);
        if(first && first.getBoundingClientRect().top < bar) scrollTo({top:scrollY + first.getBoundingClientRect().top - bar - 16,behavior:"instant" as ScrollBehavior});
        const positions = cards.filter(card => !card.hidden).map(card => ({card,rect:card.getBoundingClientRect()}));
        const easing = css("--ease-arrive");
        let order = 0;
        for(const {card,rect} of positions) {
          if(rect.top > innerHeight + 80 || rect.bottom < 0) continue;
          const previous = before.get(card);
          const from = previous ? {opacity:1,transform:`translate(${previous.left - rect.left - scrollX}px,${previous.top - rect.top - scrollY}px)`} : {opacity:0,transform:"translateY(10px)"};
          filterAnimations.push(card.animate([from,{opacity:1,transform:"none"}],{
            duration:previous ? 330 : 460,delay:previous ? 0 : Math.min(order++,4)*35,easing,fill:"backwards",
          }));
        }
      };

      reduced.addEventListener("change", event => {if(event.matches)filterAnimations.forEach(animation => animation.cancel());});

      // ---- Sliding indicator: the category tabs' underline
      // glide to the chosen button. Placed instantly on load and on resize.
      const groups = [...document.querySelectorAll<HTMLElement>(".filters .group")];
      const place = (group: HTMLElement, glide: boolean) => {
        const ind = group.querySelector<HTMLElement>(".ind");
        const on = group.querySelector<HTMLElement>('button[aria-pressed="true"]');
        if (!ind || !on) return;
        if (!glide) ind.style.transition = "none";
        ind.style.setProperty("--x", `${on.offsetLeft}px`);
        ind.style.setProperty("--w", `${on.offsetWidth}px`);
        if (!glide) { void ind.offsetWidth; ind.style.transition = ""; }
      };
      const placeAll = () => groups.forEach((g) => place(g, false));
      groups.forEach((g) => g.classList.add("has-ind"));
      placeAll();
      document.fonts?.ready.then(placeAll);
      if ("ResizeObserver" in window) groups.forEach((g) => new ResizeObserver(() => place(g, false)).observe(g));

      groups.forEach((group) => {
        group.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("button");
          if (!btn || btn.getAttribute("aria-pressed") === "true") return;
          group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          place(group, true);
          btn.scrollIntoView({ block: "nearest", inline: "nearest", behavior: reduced.matches ? "auto" : "smooth" });
          expanded = true;
          state[group.dataset.filter!] = btn.dataset.value ?? "";
          revealAll(document.getElementById("work")!);
          if (reduced.matches) return apply();
          swap();
        });
      });

      document.getElementById("filter-reset")?.addEventListener("click", () => {
        expanded = true;
        state.category = "";
        groups.forEach((g) => g.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === ""))));
        apply(); placeAll(); revealAll(document.getElementById("work")!);
        groups[0]?.querySelector<HTMLButtonElement>("button")?.focus();
      });

      apply();
      document.getElementById("work-expand")?.addEventListener("click", () => {
        const next = [...document.querySelectorAll<HTMLElement>("#work .card")].find(card => card.hidden);
        expanded = true;
        apply();
        revealAll(document.getElementById("work")!);
        next?.querySelector<HTMLAnchorElement>('a:not([aria-hidden="true"])')?.focus({preventScroll:true});
        next?.scrollIntoView({block:"center",behavior:reduced.matches ? "instant" : "smooth"});
      });

    </script>
  </body>
</html>

