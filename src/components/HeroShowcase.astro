---
import SiteHeader from "./SiteHeader.astro";
import { strings, homePath, questionnairePath, type Lang } from "../i18n";
import { srcset, src800, screenshotSrc } from "../img";
interface Project { slug: string; title: string; url: string | null; maker: string; image: string | null }
interface Props { lang: Lang; projects: Project[]; total: number }
const { lang, projects, total } = Astro.props;
const fr = lang === "fr", t = strings[lang];
const L = (frText: string, enText: string, itText: string) => (lang === "fr" ? frText : lang === "en" ? enText : itText);
const opening = ["ristorante-lola", "filton-athletic-fc", "planb-global-connect", "wall-street"];
const heroProjects = projects.filter(p => p.slug !== "jan-stenborg").map(p => p.slug === "tandoor-global" ? projects.find(site => site.slug === "jan-stenborg") : p).filter((p): p is Project => !!p);
const selected = [...opening.map(id => heroProjects.find(p => p.slug === id)), ...heroProjects.filter(p => !opening.includes(p.slug))].filter((p): p is Project => !!p?.image && !!p.url && p.slug !== "addy-sap-connect");
const words = L("Transformez vos visiteurs|en clients.", "Turn visitors|into customers.", "Trasforma i visitatori|in clienti.").split("|");
---
<SiteHeader lang={lang} alternates={homePath} />
<header class="showcase" data-showcase data-language={lang} data-view="desktop" data-paused="false" aria-labelledby="showcase-title">
  <div class="ambience" aria-hidden="true"><span class="halo"></span><span class="coordinate b">{L("THE VITRINE — ATELIER WEB", "THE VITRINE — WEB ATELIER", "THE VITRINE — ATELIER WEB")}</span></div>
  <div class="intro">
    <p class="eyebrow arrival"><span class="signal" aria-hidden="true"></span>{L("Sites web sur mesure · Fréjus & Côte d'Azur", "Bespoke websites · French Riviera & UK", "Siti web su misura · Costa Azzurra e Italia")}</p>
    <h1 id="showcase-title"><span class="word-line"><span>{words[0]}</span></span> <span class="word-line accent"><em>{words[1]}</em></span></h1>
    <div class="intro-bottom">
      <p class="lede arrival">{L("Des sites rapides et sur mesure, pensés pour vendre. On vous trouve, on vous choisit, on vous appelle.", "Fast, made-to-measure websites built to sell. Customers find you, choose you and call you.", "Siti veloci e su misura, pensati per vendere. I clienti ti trovano, ti scelgono e ti chiamano.")}</p>
      <div class="actions arrival"><a class="project-cta" href={questionnairePath[lang]}>{t.heroCta2}<span aria-hidden="true">↗</span></a><a class="work-cta" href="#work">{L("Voir nos sites", "See our sites", "Guarda i nostri siti")}<span aria-hidden="true">↓</span></a></div>
    </div>
  </div>
  <div class="exhibition" data-exhibition>
    <div class="exhibit-top"><p><span class="signal" aria-hidden="true"></span>{L("Du réel. Pas une maquette.", "Real websites. Not mockups.", "Siti reali. Non prototipi.")}</p><span class="collection">{L("RÉALISATIONS", "OUR WORK", "PROGETTI")} / <span data-project-count>01</span> / {String(selected.length).padStart(2,"0")}</span></div>
    <div class="portal" data-portal>
      <div class="architecture" aria-hidden="true"><i class="rail left"></i><i class="rail right"></i><i class="lintel"></i><i class="base"></i><span class="cross top">+</span><span class="cross bottom">+</span><div class="orbit"></div></div>
      <div class="depth" data-depth>
        {selected.map((p,i) => <div class="project-scene" data-scene data-index={i} aria-hidden={i ? "true" : undefined} inert={i > 0}>
          <a class="desktop-device" href={p.url!} target="_blank" rel="noopener" aria-label={`${p.title} — ${L("visiter le site", "visit website", "visita il sito")}`}>
            <div class="device-chrome" aria-hidden="true"><span class="traffic"><i></i><i></i><i></i></span><span>{new URL(p.url!).hostname.replace(/^www\./, "")}</span><span>↗</span></div>
            <img src={i === 0 ? src800(p.image!) : undefined} srcset={i === 0 ? srcset(p.image!) : undefined} data-src={src800(p.image!)} data-srcset={srcset(p.image!)} sizes="(min-width: 1100px) 760px, (min-width: 640px) 85vw, 92vw" width="1280" height="800" alt={t.shotAlt.replace("{title}",p.title).replace("{host}",new URL(p.url!).host)} fetchpriority={i === 0 ? "high" : undefined} loading={i ? "lazy" : "eager"} />
          </a>
          <a class="mobile-device" href={p.url!} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><span class="speaker"></span><img src={i === 0 ? screenshotSrc(`/shots/mobile/${p.slug}.webp`) : undefined} data-src={screenshotSrc(`/shots/mobile/${p.slug}.webp`)} width="390" height="844" alt="" loading={i ? "lazy" : "eager"} /><span class="home-indicator"></span></a>
        </div>)}
      </div>
      <div class="view-controls" role="group" aria-label={L("Présentation du site", "Website presentation", "Presentazione del sito")}><button type="button" data-view-button="desktop" aria-pressed="true"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2" y="3" width="16" height="11" rx="2"/><path d="M7 18h6M10 14v4"/></svg>{L("Grand écran", "Desktop", "Desktop")}</button><button type="button" data-view-button="mobile" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="1" width="10" height="18" rx="2"/><path d="M9 16h2"/></svg>Mobile</button></div>
    </div>
    <div class="exhibit-bottom">
      <div class="project-title"><span class="small-label">{L("À L'AFFICHE", "IN THE WINDOW", "IN VETRINA")}</span><strong class="sr-only" data-title>{selected[0]?.title}</strong><select data-project-picker aria-label={L("Choisir une réalisation", "Choose a project", "Scegli un progetto")}>{selected.map((p,i)=><option value={i}>{p.title}</option>)}</select><span class="project-maker">The Vitrine / {L("Conception & développement", "Design & development", "Progettazione e sviluppo")}</span></div>
      <div class="project-controls"><button type="button" data-previous aria-label={L("Projet précédent", "Previous project", "Progetto precedente")}>←</button><button type="button" data-pause aria-pressed="false" aria-label={t.heroPause} data-pause-label={t.heroPause} data-play-label={t.heroPlay}><span data-pause-icon aria-hidden="true">Ⅱ</span></button><button type="button" data-next aria-label={L("Projet suivant", "Next project", "Progetto successivo")}>→</button></div>
    </div>
  </div>
  <p class="statement">
    <span>{L("Votre activité mérite mieux qu'un site.", "Your business deserves more than a website.", "La tua attività merita più di un sito.")}</span>
    <em>{L("Elle mérite une vitrine.", "It deserves a shop window.", "Merita una vetrina.")}</em>
  </p>
  <span class="sr-only" data-announcement role="status"></span>
  <script type="application/json" data-projects set:html={JSON.stringify(selected.map(p => ({title:p.title}))).replace(/</g,"\\u003c")} />
</header>
<script>
  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach(root => {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const data: {title: string}[] = JSON.parse(root.querySelector("[data-projects]")!.textContent!);
    const scenes = [...root.querySelectorAll<HTMLElement>("[data-scene]")];
    const pause = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    const portal = root.querySelector<HTMLElement>("[data-portal]")!;
    let index = 0, desiredIndex = 0, mobile = false, paused = motion.matches, visible = true, focused = false, hovered = false;
    let explicitlyPlaying = false, selectionVersion = 0, loading = false;
    type Connection = { saveData?: boolean; effectiveType?: string; downlink?: number };
    const connection = (navigator as Navigator & { connection?: Connection }).connection;
    const canPreload = () => !motion.matches && visible && !document.hidden && !connection?.saveData &&
      !["slow-2g", "2g", "3g"].includes(connection?.effectiveType ?? "") &&
      (connection?.downlink === undefined || connection.downlink >= 1.5);
    const setPaused = (value: boolean) => {
      paused = value; if(value) explicitlyPlaying = false; root.dataset.paused = String(value); pause.hidden = motion.matches;
      pause.setAttribute("aria-pressed", String(value));
      pause.setAttribute("aria-label", value ? pause.dataset.playLabel! : pause.dataset.pauseLabel!);
      root.querySelector("[data-pause-icon]")!.textContent = value ? "▷" : "Ⅱ";
    };
    const setView = (value: boolean) => {
      mobile = value; root.dataset.view = value ? "mobile" : "desktop";
      root.querySelectorAll<HTMLButtonElement>("[data-view-button]").forEach(b => b.setAttribute("aria-pressed", String((b.dataset.viewButton === "mobile") === value)));
    };
    const picker = root.querySelector<HTMLSelectElement>("[data-project-picker]")!;
    // Explicit selections load eagerly, then decode both views before swapping.
    // A deadline or failed image keeps the current, complete project on screen.
    const load = async (scene: HTMLElement): Promise<boolean> => {
      const images = [...scene.querySelectorAll<HTMLImageElement>("img[data-src]")];
      const ready = Promise.all(images.map(async img => {
        if(!img.getAttribute("src") || (img.complete && !img.naturalWidth)) {
          img.loading = "eager";
          if(img.dataset.srcset) img.srcset = img.dataset.srcset;
          img.src = img.dataset.src!;
        }
        try { await img.decode(); return img.naturalWidth > 0; }
        catch { return false; }
      })).then(results => results.every(Boolean));
      let deadline: ReturnType<typeof setTimeout> | undefined;
      try {
        return await Promise.race([ready, new Promise<boolean>(resolve => {
          deadline = setTimeout(() => resolve(false), 15000);
        })]);
      } finally { clearTimeout(deadline); }
    };
    const setLoading = (value: boolean) => {
      loading = value; root.dataset.loading = String(value);
      portal.setAttribute("aria-busy", String(value));
    };
    const activate = (next: number, announce = false) => {
      index = next; desiredIndex = next;
      picker.value = String(index);
      scenes.forEach((scene,i) => { scene.inert = i !== index; scene.setAttribute("aria-hidden",String(i !== index)); scene.dataset.active = String(i === index); });
      root.querySelector("[data-title]")!.textContent = data[index].title;
      root.querySelector("[data-project-count]")!.textContent = String(index+1).padStart(2,"0");
      if(announce) root.querySelector("[data-announcement]")!.textContent = data[index].title;
    };
    const select = async (next: number, announce = false) => {
      const target = (next + scenes.length) % scenes.length;
      desiredIndex = target;
      const version = ++selectionVersion;
      setLoading(true);
      const ready = await load(scenes[target]);
      if(version !== selectionVersion) return;
      setLoading(false);
      if(!ready) {
        desiredIndex = index; picker.value = String(index); setPaused(true);
        root.querySelector("[data-announcement]")!.textContent = ({
          fr: "L'aperçu n'a pas pu être chargé. Le projet précédent reste affiché. Réessayez ou choisissez un autre projet.",
          it: "Impossibile caricare l'anteprima. Resta visualizzato il progetto precedente. Riprova o scegli un altro progetto.",
        } as Record<string, string>)[document.documentElement.lang] ?? "The preview could not load. The previous project is still displayed. Try again or choose another project.";
        return;
      }
      // Hover, focus or Pause during a pending automatic change cancels that change.
      if(!announce && (paused || motion.matches || !visible || document.hidden || ((focused || hovered) && !explicitlyPlaying))) {
        desiredIndex = index; picker.value = String(index); return;
      }
      setView(false); activate(target, announce);
    };
    picker.addEventListener("change",()=>{setPaused(true);void select(Number(picker.value),true);});
    root.querySelector("[data-next]")!.addEventListener("click",()=>{setPaused(true);void select(desiredIndex+1,true);});
    root.querySelector("[data-previous]")!.addEventListener("click",()=>{setPaused(true);void select(desiredIndex-1,true);});
    pause.addEventListener("click",()=>{
      const resume = paused;
      setPaused(!paused);
      // An explicit Play overrides the focus/hover that the Play button itself creates.
      explicitlyPlaying = resume;
    });
    root.querySelectorAll<HTMLButtonElement>("[data-view-button]").forEach(b=>b.addEventListener("click",()=>{setPaused(true);setView(b.dataset.viewButton === "mobile");}));
    root.querySelector("[data-exhibition]")!.addEventListener("pointerenter",()=>{hovered=true;explicitlyPlaying=false;});
    root.querySelector("[data-exhibition]")!.addEventListener("pointerleave",()=>hovered=false);
    root.addEventListener("focusin",e=>{focused=true;if(e.target!==pause)explicitlyPlaying=false;});
    root.addEventListener("focusout",e=>focused=!!e.relatedTarget && root.contains(e.relatedTarget as Node));
    const observer = new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;root.dataset.visible=String(visible && !document.hidden);if(!visible)resetDepth();},{threshold:.05});observer.observe(root);
    document.addEventListener("visibilitychange",()=>{root.dataset.visible=String(visible && !document.hidden);if(document.hidden)resetDepth();});
    setPaused(paused);activate(0);root.dataset.ready="true";
    // Warm only the next pair; the other projects have no image request until needed.
    const warmNext = () => {if(canPreload()) void load(scenes[(index+1)%scenes.length]);};
    setTimeout(warmNext,2500);
    // One responsive transformation, then the next real project. Never steal focus.
    setInterval(()=>{if(paused || motion.matches || !visible || loading || ((focused || hovered) && !explicitlyPlaying) || document.hidden)return;if(!mobile)setView(true);else{void select(index+1).then(()=>setTimeout(warmNext,1200));}},6500);
    let frame = 0, x = 0, y = 0, cx = 0, cy = 0;
    const tick = () => {
      cx+=(x-cx)*.09;cy+=(y-cy)*.09;
      portal.style.setProperty("--rx",`${cy.toFixed(3)}deg`);portal.style.setProperty("--ry",`${cx.toFixed(3)}deg`);
      if(Math.abs(x-cx)+Math.abs(y-cy)>.015)frame=requestAnimationFrame(tick);else frame=0;
    };
    function resetDepth(){x=0;y=0;if(frame)cancelAnimationFrame(frame);frame=0;cx=0;cy=0;portal.style.setProperty("--rx","0deg");portal.style.setProperty("--ry","0deg");}
    portal.addEventListener("pointermove",e=>{if(motion.matches||paused||!fine.matches||!visible)return;const r=portal.getBoundingClientRect();x=((e.clientX-r.left)/r.width-.5)*5;y=-((e.clientY-r.top)/r.height-.5)*4;if(!frame)frame=requestAnimationFrame(tick);});
    portal.addEventListener("pointerleave",()=>{x=0;y=0;if(!motion.matches&&!frame)frame=requestAnimationFrame(tick);});
    motion.addEventListener("change",()=>{if(motion.matches){setPaused(true);resetDepth();}});
    pause.addEventListener("click",()=>{if(paused)resetDepth();});
    // A short scroll-linked expansion hands the exhibition over to the portfolio.
    let scrollFrame = 0;
    const updateScroll=()=>{scrollFrame=0;if(motion.matches||paused||!visible)return;const progress=Math.max(0,Math.min(1,-root.getBoundingClientRect().top/root.offsetHeight));portal.style.setProperty("--scroll",String(progress));};
    addEventListener("scroll",()=>{if(!scrollFrame&&!motion.matches&&visible)scrollFrame=requestAnimationFrame(updateScroll);},{passive:true});
  });
</script>
<style>
  .showcase { --cream:#f6f2ea; --muted:#b4c0dc; --gold:#ffc27d; --arrive:cubic-bezier(.16,1,.3,1); position:relative; isolation:isolate; overflow:hidden; background:#081227; color:var(--cream); padding:clamp(2rem,5vw,5rem) max(1.25rem,calc((100vw - 1280px)/2)) 0; color-scheme:dark; }
  .ambience { position:absolute; inset:0; z-index:-1; overflow:hidden; background:radial-gradient(ellipse at 80% 48%,#21365b66,transparent 60%); }
  .halo { position:absolute; width:65vw; aspect-ratio:1; right:-18vw; top:8%; border-radius:50%; background:radial-gradient(circle,#b7783838,transparent 65%); animation:atmosphere 12s cubic-bezier(.45,0,.55,1) infinite alternate; }
  .coordinate { position:absolute; color:#a7b3cc; font-size:9px; letter-spacing:.18em; writing-mode:vertical-rl; }.coordinate.b{right:18px;top:24%}
  .intro { pointer-events:none; position:relative; z-index:2; max-width:1280px; margin:auto; }
  .intro > * { pointer-events:auto; }
  .eyebrow {display:flex;gap:.7rem;align-items:center;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 1.8rem;}
  .signal {display:inline-block;width:6px;height:6px;background:var(--gold);border-radius:50%;box-shadow:0 0 12px #ffc27d88;flex:none;}
  h1 {font-family:var(--font-fraunces);font-weight:500;font-size:clamp(3.4rem,7vw,6rem);line-height:.95;letter-spacing:-.065em;margin:0;position:relative;}
  .word-line {display:block;overflow:hidden;padding-bottom:.12em;margin-bottom:-.12em;}.word-line>span,.word-line>em {display:inline-block;animation:word-arrives 1.05s var(--arrive) both;animation-delay:.08s;}
  .word-line.accent {font-size:1.2em;letter-spacing:-.07em;color:var(--gold);}.word-line>em {font-weight:500;animation-delay:.2s;}
  [data-language="en"] .word-line.accent { font-size: 1em; }
  .intro-bottom {max-width:410px;margin-top:1.6rem;}.lede {color:var(--muted);font-size:1rem;line-height:1.7;margin:0;max-width:35ch;}
  .actions {display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-top:1.4rem;}.actions a {font-size:.85rem;text-decoration:none;display:inline-flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:48px;}
  .project-cta {padding:.8rem 1.2rem;background:linear-gradient(180deg,#ffe2b8,#ffc27d);color:#18140e;border-radius:99px;box-shadow:0 8px 24px -12px #ffc27d80;transition:transform .3s var(--arrive),box-shadow .3s var(--arrive);}.project-cta span{font-size:1.4rem;transition:transform .3s var(--arrive)}.project-cta:hover{transform:translateY(-3px);box-shadow:0 10px 36px -10px #ffc27d80}.project-cta:hover span{transform:translate(2px,-2px)}.work-cta{color:var(--cream);border-bottom:1px solid #ffffff40;transition:border-color .3s var(--arrive)}.work-cta:hover{border-color:var(--gold)}
  .exhibition {position:relative;z-index:1;max-width:1280px;margin:3rem auto 0;}.exhibit-top,.exhibit-bottom{display:flex;justify-content:space-between;align-items:center;gap:1rem;}.exhibit-top{font-size:.65rem;letter-spacing:.08em;color:var(--muted);}.exhibit-top p{display:flex;align-items:center;gap:.6rem;margin:0}.collection{font-size:.6rem;white-space:nowrap;color:var(--gold)}
  .portal {--rx:0deg;--ry:0deg;--scroll:0;--portal-height:clamp(285px,53vw,600px);position:relative;height:var(--portal-height);perspective:1600px;margin:1rem 0;}
  .architecture {position:absolute;inset:2% 4% 10%;pointer-events:none;transform:scale(calc(1 + var(--scroll)*.06));}.rail{position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(transparent,#ffc27d88 20%,#ffc27d33 80%,transparent);transform-origin:top;animation:rail-arrives 1.2s var(--arrive) both;}.rail.left{left:0}.rail.right{right:0}.lintel,.base{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#ffc27daa,transparent);transform-origin:left;animation:rail-arrives 1.2s var(--arrive) both;}.lintel{top:0}.base{bottom:0;box-shadow:0 12px 70px 15px #ffc27d20;}.cross{position:absolute;color:var(--gold);font-size:15px;font-style:normal;}.cross.top{top:-10px;left:-5px}.cross.bottom{bottom:-9px;right:-5px}.orbit {position:absolute;inset:14% 6%;border:1px solid #9aaece1a;border-radius:50%;transform:rotate(-20deg);}
  .rail::after {content:"";position:absolute;inset:0;width:2px;height:25%;background:linear-gradient(transparent,#ffe1b8,transparent);box-shadow:0 0 16px #ffc27d55;animation:light-travels 7s cubic-bezier(.45,0,.55,1) infinite;}.rail.right::after{animation-delay:3.5s;}
  .depth {position:absolute;inset:0;transform-style:preserve-3d;transform:rotateX(var(--rx)) rotateY(var(--ry)) scale(calc(1 + var(--scroll)*.035));}
  .project-scene {position:absolute;inset:0;opacity:1;transition:opacity .7s var(--arrive),transform 1.1s var(--arrive);}.project-scene[aria-hidden="true"]{opacity:0;pointer-events:none;transform:translateY(24px) scale(.98);}
  .desktop-device {position:absolute;left:3%;top:9%;width:85%;text-decoration:none;border:1px solid #bdcbe055;border-radius:10px;overflow:hidden;background:#101b2e;box-shadow:0 30px 65px #01071380;transform:rotateY(-8deg) rotateX(3deg);transition:transform 1.2s var(--arrive),opacity .9s var(--arrive);}
  .device-chrome {display:flex;align-items:center;justify-content:space-between;height:28px;padding:0 10px;background:linear-gradient(180deg,#263550,#172239);color:#d3dced;font-size:8px;letter-spacing:.03em;}.traffic{display:flex;gap:4px;}.traffic i{width:5px;height:5px;border-radius:50%;background:#718098}.traffic i:first-child{background:#ffc27d}.desktop-device img {display:block;width:100%;height:auto;max-height:calc(var(--portal-height)*.72);aspect-ratio:1.6;object-fit:cover;object-position:top;}
  .mobile-device {position:absolute;right:3%;top:26%;width:min(23%,calc(var(--portal-height)*.32));border:4px solid #202a3c;border-radius:19px;overflow:hidden;box-shadow:0 18px 45px #0009,0 0 0 1px #c0ccde66;background:#101727;transform:translateZ(45px) rotateY(-10deg) rotateZ(5deg);transition:transform 1.2s var(--arrive),opacity .9s var(--arrive);}.mobile-device img{display:block;width:100%;height:auto;aspect-ratio:390/844;}.speaker{position:absolute;z-index:1;top:5px;left:34%;width:32%;height:8px;background:#0b1018;border-radius:0 0 8px 8px;}.home-indicator{position:absolute;bottom:5px;left:35%;width:30%;height:3px;background:#f6f2eaaa;border-radius:2px;}
  [data-view="mobile"] .desktop-device{transform:translateX(-3%) rotateY(4deg) scale(.92);opacity:.4;}[data-view="mobile"] .mobile-device{transform:translateX(-30%) translateY(-8%) translateZ(90px) rotateY(0deg) rotateZ(-3deg) scale(1.12);}
  .view-controls{position:absolute;z-index:5;bottom:0;left:3%;display:flex;gap:4px;padding:4px;background:#081227ec;border:1px solid #8c9db93d;border-radius:99px;}.view-controls button{border:0;background:transparent;color:var(--muted);display:flex;gap:.5rem;align-items:center;padding:.6rem .8rem;border-radius:99px;font:inherit;font-size:.65rem;min-height:36px;cursor:pointer;}.view-controls button[aria-pressed="true"]{background:#26334b;color:var(--cream)}.view-controls svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.2;}
  .exhibit-bottom{position:relative;z-index:6;padding:.75rem 3% 0;}.project-title{display:grid;min-width:0;max-width:calc(100% - 135px);gap:.3rem;}.small-label{font-size:.55rem;letter-spacing:.18em;color:var(--gold);}.project-title select{min-width:0;width:100%;max-width:100%;border:0;border-bottom:1px solid #8797b64d;border-radius:0;background:#081227;color:var(--cream);padding:.3rem 1.5rem .3rem 0;font-family:var(--font-fraunces);font-size:1.25rem;font-weight:500;}.project-maker{font-size:.65rem;color:var(--muted);}.project-controls{display:flex;gap:6px}.project-controls button{width:40px;height:40px;border:1px solid #8699bc50;border-radius:50%;background:transparent;color:var(--cream);font:inherit;cursor:pointer;transition:background .3s var(--arrive),border-color .3s var(--arrive)}.project-controls button:hover{background:#ffffff0a;border-color:var(--gold)}
  
