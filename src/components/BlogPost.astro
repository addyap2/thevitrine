---
// One article. Drafts carry a notice and stay out of search engines.
import SubPage from "./SubPage.astro";
import { render } from "astro:content";
import { strings, blogPath, postPath, homePath, casePath, type Lang } from "../i18n";
import { translationOf, isPublished, minutes, formatDate, nextFor, projectFor, shareImage, type Post } from "../blog";
import { caseSlug } from "../data/cases";
import { srcset, src800 } from "../img";

interface Props { post: Post }
const { post } = Astro.props;
const lang = post.data.lang as Lang;
const t = strings[lang];
const { Content } = await render(post);
const other = await translationOf(post);
const otherLang: Lang = lang === "fr" ? "en" : "fr";
const paths = { [lang]: postPath(lang, post.data.slug), [otherLang]: other ? postPath(otherLang, other.data.slug) : blogPath[otherLang] } as Record<Lang, string>;
const abs = (path: string) => new URL(path, Astro.site).href;
const draft = !isPublished(post);
const authors = post.data.authors.map((a) => (a === "Julien" ? "Julien Bourgois" : "Antony Addy"));
const iso = post.data.date.toISOString().slice(0, 10);

// The screenshot at the top, the case studies cited, and what to read next.
const cover = post.data.cover ? projectFor(post.data.cover) : null;
const cases = post.data.cases.map(projectFor);
const next = (await nextFor(post)).map((p) => ({ post: p, cover: p.data.cover ? projectFor(p.data.cover) : null }));
const caseHref = (slug: string) => casePath(lang, caseSlug(slug));
const coverSizes = "(min-width: 760px) 704px, calc(100vw - 2rem)";
const thumbSizes = "(min-width: 760px) 340px, calc(100vw - 2rem)";

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "The Vitrine", item: abs(homePath[lang]) },
        { "@type": "ListItem", position: 2, name: t.blogName, item: abs(blogPath[lang]) },
        { "@type": "ListItem", position: 3, name: post.data.title, item: abs(paths[lang]) },
      ],
    },
    {
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      inLanguage: lang,
      datePublished: iso,
      dateModified: (post.data.updated ?? post.data.date).toISOString().slice(0, 10),
      url: abs(paths[lang]),
      mainEntityOfPage: abs(paths[lang]),
      image: abs(shareImage(post)),
      author: post.data.authors.map((a) => ({ "@id": abs(a === "Julien" ? "/#julien" : "/#antony") })),
      publisher: { "@id": abs("/#organization") },
    },
  ],
};
---

<SubPage
  lang={lang}
  title={`${post.data.seoTitle ?? post.data.title} | The Vitrine`}
  description={post.data.description}
  paths={paths}
  noindex={draft}
  ogType="article"
  current="blog"
  ld={ld}
  ogImage={shareImage(post)}
  ogAlt={post.data.title}
  notice={draft ? t.blogDraft : null}
>
  <main id="main-content" tabindex="-1" class="wrap post">
    <nav class="crumbs" aria-label={lang === "fr" ? "Fil d'Ariane" : "Breadcrumb"}>
      <a href={homePath[lang]}>The Vitrine</a> <span aria-hidden="true">/</span>
      <a href={blogPath[lang]}>{t.blogName}</a>
    </nav>
    <article>
      <header>
        <h1>{post.data.title}</h1>
        <p class="meta">
          {t.blogBy} {authors.join(` ${t.blogAnd} `)}{" "}<span aria-hidden="true">·</span>{" "}
          <time datetime={iso}>{formatDate(post.data.date, lang)}</time>{" "}<span aria-hidden="true">·</span>{" "}
          {minutes(post)} {t.blogMinutes}
        </p>
        <p class="lede">{post.data.description}</p>
      </header>
      {cover && (
        <figure class="cover">
          <div class="frame">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <picture>
              <source type="image/webp" srcset={srcset(cover.image)} sizes={coverSizes} />
              <img src={cover.image} alt="" width="1280" height="800" fetchpriority="high" decoding="async" />
            </picture>
          </div>
          <figcaption>
            {t.blogCover.replace("{name}", cover.title)} · <a href={caseHref(cover.slug)}>{t.blogCoverLink} <span aria-hidden="true">→</span></a>
          </figcaption>
        </figure>
      )}
      <div class="prose">
        <Content />
      </div>
    </article>

    {cases.length > 0 && (
      <section class="cases" aria-labelledby="cases-title">
        <h2 id="cases-title">{t.blogCases}</h2>
        <ul>
          {cases.map((c) => (
            <li>
              <a href={caseHref(c.slug)}>
                <img src={src800(c.image)} alt="" width="1280" height="800" loading="lazy" decoding="async" />
                <span class="name">{c.title}</span>
                <span class="go">{t.blogCoverLink} <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {next.length > 0 && (
      <nav class="next" aria-labelledby="next-title">
        <div class="next-head">
          <h2 id="next-title">{t.blogNext}</h2>
          <a class="all" href={blogPath[lang]}>{t.blogAll} <span aria-hidden="true">→</span></a>
        </div>
        <ul>
          {next.map(({ post: p, cover: c }) => (
            <li>
              <a href={postPath(lang, p.data.slug)}>
                {c && (
                  <picture>
                    <source type="image/webp" srcset={srcset(c.image)} sizes={thumbSizes} />
                    <img src={c.image} alt="" width="1280" height="800" loading="lazy" decoding="async" />
                  </picture>
                )}
                <span class="title">{p.data.title}</span>
                <span class="desc">{p.data.description}</span>
                <span class="go">{t.blogRead} <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </main>
</SubPage>

<style>
  .post { max-width: 44rem; padding-top: 3rem; padding-bottom: 5rem; }
  .crumbs { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 2rem; }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-family: var(--font-fraunces); font-weight: 500; font-size: clamp(2.1rem, 5.5vw, 3.3rem); line-height: 1.06; letter-spacing: -0.025em; margin: 0; text-wrap: balance; }
  .meta { margin: 1rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  .lede { margin: 1.5rem 0 0; padding-bottom: 2rem; border-bottom: 1px solid var(--line); font-size: 1.2rem; line-height: 1.6; color: var(--ink); }

  /* Long-form text: a comfortable measure, generous spacing, quiet accents. */
  .prose { margin-top: 2rem; font-size: 1.1rem; line-height: 1.75; color: var(--ink); }
  .prose :global(p) { margin: 0 0 1.25rem; text-wrap: pretty; }
  .prose :global(h2) { margin: 2.75rem 0 0.9rem; font-family: var(--font-fraunces); font-weight: 500; font-size: 1.6rem; line-height: 1.25; letter-spacing: -0.015em; }
  .prose :global(h3) { margin: 2rem 0 0.6rem; font-size: 1.1rem; font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem; padding-left: 1.4rem; }
  .prose :global(li) { margin: 0.4rem 0; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(a) { color: var(--brand); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(blockquote) { margin: 1.75rem 0; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 2px solid var(--lamp); color: var(--ink-soft); font-style: italic; }

  /* The cover: a project screenshot in a quiet browser frame. */
  .cover { margin: 2.25rem 0 0; }
  .frame { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); box-shadow: 0 24px 50px -30px rgb(8 18 39 / 0.45); }
  .dots { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--ink-soft); }
  figcaption a { color: var(--brand); text-underline-offset: 3px; }

  .cases, .next { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .cases h2, .next h2 { margin: 0; font-family: var(--font-fraunces); font-weight: 500; font-size: 1.5rem; letter-spacing: -0.01em; }
  .cases ul, .next ul { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .cases ul { grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); }
  .next ul { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .cases a, .next li a {
    display: flex; flex-direction: column; height: 100%; overflow: hidden;
    border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--ink); text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease-hover), transform var(--dur-short) var(--ease-hover);
  }
  .cases img, .next img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }
  .name, .title { padding: 0.9rem 1.1rem 0; font-family: var(--font-fraunces); line-height: 1.25; }
  .name { font-size: 1.1rem; }
  .title { font-size: 1.2rem; text-wrap: balance; }
  .desc { padding: 0.5rem 1.1rem 0; font-size: 0.92rem; line-height: 1.55; color: var(--ink-soft); }
  .go { margin-top: auto; padding: 0.75rem 1.1rem 1rem; font-size: 0.88rem; font-weight: 600; color: var(--brand); }
  .next-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
  .all { font-size: 0.9rem; color: var(--ink-soft); text-decoration: none; }
  .all:hover { color: var(--accent); }
  @media (hover: hover) {
    .cases a:hover, .next li a:hover { border-color: var(--accent); transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) { .cases a:hover, .next li a:hover { transform: none; } }
</style>
