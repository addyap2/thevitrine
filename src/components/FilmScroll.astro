---
// "Ils entrent": a short first-person film, scrubbed by scroll, that walks
// down a sunny street to a shop door and ends on the statement. The frames are
// stills from one generated clip (public/film/street/001–094.webp; the clip's
// later frames were cut), drawn on a canvas inside a sticky stage. No video
// element, no scroll interception.
import type { Lang } from "../i18n";
import LogoWord from "./LogoWord.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (frText: string, enText: string, itText: string) => (lang === "fr" ? frText : lang === "en" ? enText : itText);
const FRAMES = 94;
const frame = (n: number) => `/film/street/${String(n).padStart(3, "0")}.webp`;
const beats = [
  { from: 0.04, to: 0.4, text: L("Ils passent.", "They walk by.", "Passano.") },
  { from: 0.42, to: 0.66, text: L("Ils s'arrêtent.", "They stop.", "Si fermano.") },
  { from: 0.68, to: 0.82, text: L("Ils entrent.", "They come in.", "Entrano.") },
];
---
<section class="film" data-film data-frames={FRAMES} aria-labelledby="film-statement">
  <div class="stage">
    <img class="poster" src={frame(1)} width="1280" height="720" alt="" decoding="async" />
    <canvas width="1280" height="720" aria-hidden="true"></canvas>
    <div class="veil" aria-hidden="true"></div>
    {beats.map((b) => <p class="beat" data-from={b.from} data-to={b.to}>{b.text}</p>)}
    <p class="statement" id="film-statement">
      <span>{L("Votre activité mérite mieux qu'un site.", "Your business deserves more than a website.", "La tua attività merita più di un sito.")}</span>
      <span class="deserves"><em>{L("Elle mérite", "It deserves", "Merita")}</em> <LogoWord manual /></span>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-film]").forEach((root) => {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const logo = root.querySelector<HTMLElement>("[data-logo-word]")!;
    // Reduced motion and data saving keep the still poster and the statement.
    if (motion.matches || connection?.saveData || ["slow-2g", "2g"].includes(connection?.effectiveType ?? "")) { logo.classList.add("lit"); return; }

    const canvas = root.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;
    const beats = [...root.querySelectorAll<HTMLElement>(".beat")];
    const total = Number(root.dataset.frames);
    const frames: (HTMLImageElement | null)[] = Array(total).fill(null);
    let current = -1, queued = 0;
    root.dataset.live = "true";

    const progress = () => {
      const r = root.getBoundingClientRect();
      return Math.max(0, Math.min(1, -r.top / (r.height - innerHeight)));
    };
    // Draw the wanted frame, or the nearest one already loaded.
    const draw = (index: number) => {
      for (let d = 0; d < total; d++) {
        const img = frames[index - d] ?? frames[index + d];
        if (img) {
          if (img !== frames[current]) { ctx.drawImage(img, 0, 0, canvas.width, canvas.height); current = frames.indexOf(img); }
          return;
        }
      }
    };
    const update = () => {
      queued = 0;
      const p = progress();
      // The film runs over the first 85% of the stage; the statement holds the rest.
      draw(Math.round(Math.min(1, p / 0.85) * (total - 1)));
      beats.forEach((b) => b.classList.toggle("on", p >= Number(b.dataset.from) && p < Number(b.dataset.to)));
      // On narrow screens the frame is cropped, so pan towards the action:
      // the shop ahead, then the door on the right.
      canvas.style.objectPosition = `${p < 0.3 ? 45 : p < 0.6 ? 45 + (p - 0.3) / 0.3 * 20 : 65 - Math.min(1, (p - 0.6) / 0.25) * 3}% 50%`;
      const end = p >= 0.84;
      root.classList.toggle("end", end);
      if (end) logo.classList.add("lit");
    };
    const onScroll = () => { if (!queued) queued = requestAnimationFrame(update); };

    // Load every frame once the film is near; start with every 8th so a fast
    // scroll still has something to show, then fill the gaps.
    const load = () => {
      const order = [...Array(total).keys()].sort((a, b) => (a % 8 === 0 ? 0 : 1) - (b % 8 === 0 ? 0 : 1) || a - b);
      order.forEach((i) => {
        const img = new Image();
        img.decoding = "async";
        img.onload = () => { frames[i] = img; if (Math.abs(i - current) < 8) onScroll(); };
        img.src = `/film/street/${String(i + 1).padStart(3, "0")}.webp`;
      });
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); addEventListener("scroll", onScroll, { passive: true }); addEventListener("resize", onScroll); onScroll(); }
    }, { rootMargin: "100% 0px" });
    io.observe(root);
  });
</script>

<style>
  .film { --cream:#f6f2ea; --gold:#ffc27d; --arrive:cubic-bezier(.16,1,.3,1); position:relative; height:100svh; background:#081227; color:var(--cream); }
  .film[data-live] { height:340svh; }
  .stage { position:sticky; top:0; height:100svh; overflow:hidden; }
  .poster, canvas { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .film[data-live] .poster { opacity:0; }
  .veil { position:absolute; inset:0; background:linear-gradient(180deg,#08122799 0%,transparent 22%,transparent 60%,#081227cc 100%); transition:background-color .9s var(--arrive); }
  .film.end .veil, .film:not([data-live]) .veil { background-color:#081227b3; }
  .beat { position:absolute; left:max(1.25rem,calc((100vw - 1280px)/2)); bottom:12svh; margin:0; font-family:var(--font-fraunces); font-weight:500; font-size:clamp(2.2rem,6vw,5rem); line-height:1; letter-spacing:-.05em; text-shadow:0 2px 30px #0008; opacity:0; transform:translateY(18px); transition:opacity .52s var(--arrive),transform .52s var(--arrive); }
  .beat.on { opacity:1; transform:none; }
  .statement { position:absolute; inset:auto max(1.25rem,calc((100vw - 1280px)/2)) 14svh; display:flex; flex-direction:column; gap:.15rem; margin:0; font-family:var(--font-fraunces); font-weight:500; font-size:clamp(1.7rem,3.4vw,2.9rem); line-height:1.08; letter-spacing:-.03em; }
  .film[data-live] .statement { opacity:0; transform:translateY(18px); transition:opacity .9s var(--arrive),transform .9s var(--arrive); }
  .film.end .statement { opacity:1; transform:none; }
  .statement em { color:var(--gold); font-style:italic; }
  .deserves { display:inline-flex; align-items:center; flex-wrap:wrap; gap:.1em .32em; }
  @media (prefers-reduced-motion: reduce) { .beat, .statement { transition:none; } }
</style>
