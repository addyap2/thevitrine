---
import Telemetry from "./Telemetry.astro";
import Brand from "./Brand.astro";
import Nav from "./Nav.astro";
import QuickContact from "./QuickContact.astro";
import { homePath, tr, type Lang } from "../i18n";
interface Props { lang: Lang; alternates?: Partial<Record<Lang, string>>; current?: "blog" | "contact" | "project" | "about" }
const { lang, alternates, current } = Astro.props;
---
<a class="skip" href={current === "contact" ? "#contact-main" : current === "project" ? "#devis-main" : "#main-content"}>{tr(lang, { fr: "Aller au contenu", en: "Skip to content", it: "Vai al contenuto" })}</a>
<Telemetry />
<div class="site-header" data-site-header>
  <div class="header-inner">
    <Brand href={homePath[lang]} />
    <Nav lang={lang} alternates={alternates} current={current} />
  </div>
</div>
{current !== "contact" && current !== "project" && <QuickContact lang={lang} />}
<script>
  import { initSiteMotion } from "../motion";
  initSiteMotion();
</script>
<style>
  .skip { position: fixed; top: 8px; left: 8px; z-index: 200; transform: translateY(-160%); padding: 12px 20px; background: #ffc27d; color: #081227; border-radius: 8px; font-weight: 600; }
  .skip:focus { transform: none; }
  :global(main:focus) { outline: none; }
  :global(:root) { --site-header-height: 80px; }
  :global(body) { padding-top: var(--site-header-height); }
  :global(html) { scroll-padding-top: calc(var(--site-header-height) + 16px); }
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    background: #081227; color: #f6f2ea; color-scheme: dark;
    --focus: #ffc27d;
    box-shadow: 0 1px 0 rgb(255 194 125 / .18), 0 8px 28px rgb(0 0 0 / .12);
  }
  .header-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 2rem;
    height: var(--site-header-height); display: flex;
    justify-content: space-between; align-items: center; gap: 1rem;
  }
  @media(max-width: 639px) {
    :global(:root) { --site-header-height: 72px; }
    .header-inner { padding-inline: 1rem; gap: .5rem; }
  }
</style>
