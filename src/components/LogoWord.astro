---
// The Vitrine logo, inline so its parts can move: the window mark, each
// letter, and the lit pane that switches on. It assembles, its pane lights up
// like a lamp, a gold glint passes, then the pane breathes. Hidden states apply
// only when scripts run; reduced motion shows the lit logo at once.
import logoRaw from "../../public/brand/logo-light.svg?raw";
interface Props { manual?: boolean }
const { manual = false } = Astro.props;
let glyph = 0;
const logoSvg = logoRaw
  .replace(/<svg([^>]*?)\s+role="img"/, "<svg$1")
  .replace(/\s+aria-label="[^"]*"/, "")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" ')
  .replace('<g fill="#f6f2ea">', '<g class="mark" fill="#f6f2ea">')
  .replace('fill="#ffc27d"/>', 'fill="#ffc27d" class="lamp"/>')
  .replace(/(<\/g>\s*)<g fill="#f6f2ea">/, '$1<g class="word" fill="#f6f2ea">')
  .replace(/<path transform=/g, () => `<path style="--i:${glyph++}" transform=`);
---
<span class="logo-word" data-logo-word data-manual={manual || undefined} role="img" aria-label="The Vitrine."><Fragment set:html={logoSvg} /><span class="glint" aria-hidden="true"></span></span>

<script>
  // The logo lights up the first time it comes into view, unless the page
  // lights it itself (data-manual: FilmScroll adds .lit at the film's end).
  document.querySelectorAll<HTMLElement>("[data-logo-word]:not([data-manual])").forEach((el) => {
    if (!("IntersectionObserver" in window)) { el.classList.add("lit"); return; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { el.classList.add("lit"); io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(el);
  });
</script>

<style>
.logo-word{--arrive:cubic-bezier(.16,1,.3,1);position:relative;display:inline-block;height:1.75em;line-height:0;transform:translateY(.02em)}
.logo-word :global(svg){display:block;height:100%;width:auto;overflow:visible}
.logo-word :global(.mark){transform-box:fill-box;transform-origin:center}
.logo-word :global(.lamp){filter:drop-shadow(0 0 6px rgb(255 194 125 / .75))}
.glint{position:absolute;inset:0;pointer-events:none;opacity:0;background:linear-gradient(105deg,transparent 35%,rgb(255 236 205 / .95) 50%,transparent 65%) no-repeat;background-size:250% 100%;background-position:120% 0;-webkit-mask:url("/brand/logo-light.svg") center/contain no-repeat;mask:url("/brand/logo-light.svg") center/contain no-repeat}
:global(.js) .logo-word:not(.lit) :global(.mark){opacity:0;transform:translateY(.12em) scale(.9)}
:global(.js) .logo-word:not(.lit) :global(.word path){opacity:0;translate:0 10px}
:global(.js) .logo-word:not(.lit) :global(.lamp){fill:#2b3756;filter:none}
.logo-word.lit :global(.mark){animation:logo-mark 1.1s .15s var(--arrive) both}
.logo-word.lit :global(.word path){animation:logo-glyph .9s var(--arrive) both;animation-delay:calc(.55s + var(--i) * 80ms)}
.logo-word.lit :global(.lamp){animation:logo-lamp 1.1s 1.7s both,logo-breathe 3.8s 3s ease-in-out infinite}
.logo-word.lit .glint{animation:logo-glint 1.4s 2.5s ease-in-out both}
@keyframes logo-mark{from{opacity:0;transform:translateY(.12em) scale(.9)}to{opacity:1;transform:none}}
@keyframes logo-glyph{from{opacity:0;translate:0 10px}to{opacity:1;translate:0 0}}
@keyframes logo-lamp{0%{fill:#2b3756;filter:none}30%{fill:#ffc27d;filter:drop-shadow(0 0 8px rgb(255 194 125 / .9))}40%{fill:#6a5636;filter:none}52%{fill:#ffc27d;filter:drop-shadow(0 0 10px rgb(255 194 125 / .95))}100%{fill:#ffc27d;filter:drop-shadow(0 0 6px rgb(255 194 125 / .75))}}
@keyframes logo-breathe{0%,100%{filter:drop-shadow(0 0 6px rgb(255 194 125 / .75))}50%{filter:drop-shadow(0 0 14px rgb(255 194 125 / 1))}}
@keyframes logo-glint{0%{opacity:1;background-position:120% 0}100%{opacity:1;background-position:-20% 0}}
@media(prefers-reduced-motion:reduce){.logo-word.lit :global(*),.logo-word.lit .glint{animation:none!important}:global(.js) .logo-word:not(.lit) :global(.mark){opacity:1;transform:none}:global(.js) .logo-word:not(.lit) :global(.word path){opacity:1;translate:0 0}:global(.js) .logo-word:not(.lit) :global(.lamp){fill:#ffc27d;filter:drop-shadow(0 0 6px rgb(255 194 125 / .75))}}
</style>
