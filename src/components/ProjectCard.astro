---
import { strings, type Lang } from "../i18n";
import { srcset, src800, sizes } from "../img";
import { cases, caseSlug } from "../data/cases";
import { casePath } from "../i18n";

interface Props {
  project: {
    slug: string;
    title: string;
    description: Record<Lang, string>;
    url: string | null;
    repo: string | null;
    maker: string;
    tags: string[];
    inProgress: boolean;
    image: string | null;
  };
  lang: Lang;
  eager?: boolean;
  /** Runs double-width in the three-column grid (see src/wide.ts). */
  wide3?: boolean;
  /** Runs full-width in the two-column grid. */
  wide2?: boolean;
}
const { project: p, lang, eager = false, wide3 = false, wide2 = false } = Astro.props;
const t = strings[lang];
const description = p.description[lang];
const host = p.url ? new URL(p.url).host.replace(/^www\./, "") : null;
// Once its case study is published, the card's title leads there (an internal
// link); until then it goes straight to the live site.
const caseHref = cases[p.slug]?.status === "published" ? casePath(lang, caseSlug(p.slug)) : null;
const titleHref = caseHref ?? p.url;
---

<article class="card" data-maker={p.maker} data-reveal data-w3={wide3 ? "" : undefined} data-w2={wide2 ? "" : undefined}>
  <a class="shot" href={p.url ?? p.repo ?? undefined} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <span class="pane">
      <span class="chrome">
        <i></i><i></i><i></i>
        {host && <span class="url">{host}</span>}
      </span>
      <span class="frame">
        {p.image ? (
          <img src={src800(p.image)} srcset={srcset(p.image)} sizes={wide3 || wide2 ? sizes.wide : sizes.card} alt={t.shotAlt.replace("{title}", p.title).replace("{host}", host ?? "")} width="1280" height="800" loading={eager ? "eager" : "lazy"} decoding="async" />
        ) : (
          <span class="placeholder">{p.title.slice(0, 1)}</span>
        )}
      </span>
    </span>
  </a>
  <div class="body">
    <div class="meta">
      <span class="maker"><i class="dot" aria-hidden="true"></i>{p.maker}</span>
      {p.inProgress && <span class="badge">{t.inProgress}</span>}
    </div>
    <h3>
      {caseHref ? <a href={caseHref}>{p.title}</a> : titleHref ? <a href={titleHref} target="_blank" rel="noopener">{p.title}</a> : p.title}
    </h3>
    {description && <p>{description}</p>}
    {p.tags.length > 0 && (
      <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
    )}
    <div class="links">
      {p.url && <a href={p.url} target="_blank" rel="noopener">{t.visit}<span class="sr-only">, {p.title}</span> <span class="arrow" aria-hidden="true">↗</span></a>}
      {p.repo && <a class="code" href={p.repo} target="_blank" rel="noopener">{t.code}</a>}
    </div>
  </div>
</article>

<style>
  /* Each card is a small shop window: a framed screenshot over a paper label. */
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    transition:
      transform var(--dur-short) var(--ease-hover),
      box-shadow var(--dur-short) var(--ease-hover),
      border-color var(--dur-micro) var(--ease-hover);
  }
  /* Hover: the window lights up warm, the same light as the hero's lamp. */
  .card:hover {
    border-color: var(--lit-edge);
    box-shadow: 0 22px 44px -28px var(--lit-glow), 0 2px 6px -4px var(--shadow);
  }
  /* Lift only where there is a real pointer, so a tap doesn't leave a card raised. */
  @media (hover: hover) { .card:hover { transform: translateY(-3px); } }
  .card[hidden] { display: none; }

  .shot {
    display: flex;
    flex-direction: column;
    background: var(--muted-bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-decoration: none;
  }
  .pane { display: flex; flex-direction: column; }
  .chrome {
    flex: none;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 10px;
    background: var(--chrome);
    border-bottom: 1px solid var(--line);
  }
  .chrome i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
  .url {
    margin-left: 8px;
    min-width: 0;
    font-size: 10.5px;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
  }
  .frame {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    /* While a screenshot loads, the pane holds a faint dusk tone instead of flat grey. */
    background: linear-gradient(160deg, var(--muted-bg), var(--chrome));
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition:
      opacity var(--dur-base) var(--ease-arrive),
      transform var(--dur-scene) var(--ease-arrive);
  }
  /* Screenshots settle into place as they load, then lean in slightly on hover. */
  :global(html.js:not(.reveal-all)) .frame img:not(.loaded) { opacity: 0; transform: scale(1.04); }
  .card:hover .frame img { transform: scale(1.025); }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--display);
    font-size: 4rem;
    color: var(--ink-soft);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.25rem 1.2rem;
    flex: 1;
  }
  .meta { display: flex; gap: 0.6rem; align-items: center; }
  /* The maker is a signature, not a headline: a quiet name with its own colour dot. */
  .maker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .card[data-maker="Julien"] .dot { background: var(--brand); }
  .badge {
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    border: 1px dashed var(--line);
    color: var(--ink-soft);
  }
  h3 {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; text-wrap: pretty; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0; padding: 0; }
  .tags li {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .links a { color: var(--ink); font-weight: 500; text-decoration: none; transition: color var(--dur-micro) var(--ease-hover); }
  .links a:hover { color: var(--accent); }
  .arrow { display: inline-block; transition: transform var(--dur-short) var(--ease-hover); }
  .links a:hover .arrow, .card:hover .links a:first-child .arrow { transform: translate(2px, -2px); }
  .links .code { color: var(--ink-soft); flex-shrink: 0; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Wide cards (breakpoints match the grid in Vitrine.astro) open a section.
     The screenshot hangs whole, as a lit pane in a dusk window (a small echo of
     the hero), with the label beside it, so a section's rows always close. */
  @media (min-width: 1000px) {
    .card[data-w3] { grid-column: span 2; flex-direction: row; }
    .card[data-w3] .shot { flex: 0 0 60%; }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .card[data-w2] { grid-column: 1 / -1; flex-direction: row; }
    .card[data-w2] .shot { flex: 0 0 58%; }
  }
  /* The lit-pane look follows the span: data-w3 only in the 3-column grid,
     data-w2 only in the 2-column grid. */
  @media (min-width: 1000px) {
    .card[data-w3] .shot {
      justify-content: center;
      padding: clamp(1.25rem, 3vw, 2.25rem);
      border-bottom: 0;
      border-right: 1px solid var(--line);
      background:
        radial-gradient(70% 60% at 60% 35%, rgb(255 178 102 / 0.3), transparent 70%),
        linear-gradient(180deg, var(--night-2), var(--night));
    }
    .card[data-w3] .pane {
      border-radius: 8px;
      overflow: hidden;
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.1),
        0 28px 50px -24px rgb(0 0 0 / 0.85),
        0 0 50px -12px rgb(255 178 102 / 0.35);
      transform: perspective(1400px) rotateY(-4deg);
      transition: transform var(--dur-scene) var(--ease-arrive), box-shadow var(--dur-short) var(--ease-hover);
    }
    .card[data-w3] .chrome { background: #17244a; border-bottom-color: rgb(255 255 255 / 0.06); }
    .card[data-w3] .chrome i { background: rgb(255 255 255 / 0.2); }
    .card[data-w3] .chrome i:first-child { background: #ff7b6b; }
    .card[data-w3] .url { color: var(--text-lo); }
    /* Hover: the pane turns to face you and its edge lights up. */
    .card[data-w3]:hover .pane {
      transform: perspective(1400px) rotateY(0deg) translateY(-2px);
      box-shadow:
        0 0 0 1px rgb(255 226 184 / 0.45),
        0 34px 60px -24px rgb(0 0 0 / 0.9),
        0 0 70px -10px rgb(255 178 102 / 0.5);
    }
    .card[data-w3]:hover .frame img { transform: none; }
    .card[data-w3] .body { padding: 1.6rem 1.6rem 1.4rem; gap: 0.7rem; justify-content: center; }
    .card[data-w3] h3 { font-size: clamp(1.5rem, 2.2vw, 1.9rem); }
    .card[data-w3] p { font-size: 1rem; }  }
  @media (min-width: 640px) and (max-width: 999px) {
    .card[data-w2] .shot {
      justify-content: center;
      padding: clamp(1.25rem, 3vw, 2.25rem);
      border-bottom: 0;
      border-right: 1px solid var(--line);
      background:
        radial-gradient(70% 60% at 60% 35%, rgb(255 178 102 / 0.3), transparent 70%),
        linear-gradient(180deg, var(--night-2), var(--night));
    }
    .card[data-w2] .pane {
      border-radius: 8px;
      overflow: hidden;
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 0.1),
        0 28px 50px -24px rgb(0 0 0 / 0.85),
        0 0 50px -12px rgb(255 178 102 / 0.35);
      transform: perspective(1400px) rotateY(-4deg);
      transition: transform var(--dur-scene) var(--ease-arrive), box-shadow var(--dur-short) var(--ease-hover);
    }
    .card[data-w2] .chrome { background: #17244a; border-bottom-color: rgb(255 255 255 / 0.06); }
    .card[data-w2] .chrome i { background: rgb(255 255 255 / 0.2); }
    .card[data-w2] .chrome i:first-child { background: #ff7b6b; }
    .card[data-w2] .url { color: var(--text-lo); }
    /* Hover: the pane turns to face you and its edge lights up. */
    .card[data-w2]:hover .pane {
      transform: perspective(1400px) rotateY(0deg) translateY(-2px);
      box-shadow:
        0 0 0 1px rgb(255 226 184 / 0.45),
        0 34px 60px -24px rgb(0 0 0 / 0.9),
        0 0 70px -10px rgb(255 178 102 / 0.5);
    }
    .card[data-w2]:hover .frame img { transform: none; }
    .card[data-w2] .body { padding: 1.6rem 1.6rem 1.4rem; gap: 0.7rem; justify-content: center; }
    .card[data-w2] h3 { font-size: clamp(1.5rem, 2.2vw, 1.9rem); }
    .card[data-w2] p { font-size: 1rem; }  }


  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:hover .frame img { transform: none; }
    .pane { transition: none !important; }
  }
</style>
