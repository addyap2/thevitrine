---
import { strings, type Lang } from "../i18n";

interface Props {
  project: {
    slug: string;
    title: string;
    description: Record<Lang, string>;
    url: string | null;
    repo: string | null;
    maker: string;
    tags: string[];
    inProgress: boolean;
    image: string | null;
  };
  lang: Lang;
  eager?: boolean;
}
const { project: p, lang, eager = false } = Astro.props;
const t = strings[lang];
const description = p.description[lang];
const host = p.url ? new URL(p.url).host.replace(/^www\./, "") : null;
---

<article class="card" data-maker={p.maker} data-reveal>
  <a class="shot" href={p.url ?? p.repo ?? undefined} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    {p.image ? (
      <img src={p.image} alt="" width="1280" height="800" loading={eager ? "eager" : "lazy"} decoding="async" />
    ) : (
      <span class="placeholder">{p.title.slice(0, 1)}</span>
    )}
  </a>
  <div class="body">
    <div class="meta">
      <span class="maker">{p.maker}</span>
      {p.inProgress && <span class="badge">{t.inProgress}</span>}
    </div>
    <h3>
      {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}
    </h3>
    {description && <p>{description}</p>}
    {p.tags.length > 0 && (
      <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
    )}
    <div class="links">
      {p.url && <a href={p.url} target="_blank" rel="noopener">{host} <span class="arrow" aria-hidden="true">↗</span></a>}
      {p.repo && <a class="code" href={p.repo} target="_blank" rel="noopener">{t.code}</a>}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    transition:
      transform var(--dur-short) var(--ease-hover),
      box-shadow var(--dur-short) var(--ease-hover);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -18px var(--shadow);
  }
  .card[hidden] { display: none; }
  .shot {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--muted-bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition:
      opacity var(--dur-base) var(--ease-arrive),
      transform var(--dur-scene) var(--ease-arrive);
  }
  /* Screenshots settle into place as they load, then lean in slightly on hover. */
  :global(html.js) .shot img:not(.loaded) { opacity: 0; transform: scale(1.04); }
  .card:hover .shot img { transform: scale(1.03); }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--display);
    font-size: 4rem;
    color: var(--ink-soft);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem 1.25rem;
    flex: 1;
  }
  .meta { display: flex; gap: 0.5rem; align-items: center; }
  .maker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .badge {
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    background: var(--muted-bg);
    color: var(--ink-soft);
  }
  h3 {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0; padding: 0; }
  .tags li {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.9rem;
  }
  .links a { color: var(--ink); font-weight: 500; text-decoration: none; overflow-wrap: anywhere; }
  .links a { transition: color var(--dur-micro) var(--ease-hover); }
  .links a:hover { color: var(--accent); }
  .arrow { display: inline-block; transition: transform var(--dur-short) var(--ease-hover); }
  .links a:hover .arrow { transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:hover .shot img { transform: none; }
  }
  .links .code { color: var(--ink-soft); flex-shrink: 0; overflow-wrap: normal; }
</style>
