---
// The people behind The Vitrine. Bios and facts live in src/data/people.ts;
// each person's site count comes from projects.json, and "See his work" opens
// the homepage with the portfolio filtered to them (?maker=…#work).
import SubPage from "./SubPage.astro";
import projects from "../data/projects.json";
import { people, principles } from "../data/people";
import { whatsapp } from "../data/business";
import { strings, aboutPath, homePath, questionnairePath, contactPath, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const abs = (path: string) => new URL(path, Astro.site).href;
const count = (maker: string) => projects.filter((p) => p.maker === maker).length;
const WA_ICON = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>';

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      url: abs(aboutPath[lang]),
      name: t.aboutTitle,
      inLanguage: lang,
      about: { "@id": abs("/#organization") },
      mainEntity: people.map((p) => ({ "@id": abs(`/#${p.id}`) })),
    },
    ...people.map((p) => ({
      "@type": "Person",
      "@id": abs(`/#${p.id}`),
      name: p.name,
      jobTitle: p.role[lang],
      description: p.bio[lang][0],
      url: p.site.url,
      sameAs: [p.site.url],
      worksFor: { "@id": abs("/#organization") },
      ...(p.photo ? { image: abs(p.photo) } : {}),
    })),
  ],
};
---

<SubPage lang={lang} title={t.aboutTitle} description={t.aboutDescription} paths={aboutPath} current="about" ld={ld}>
  <main id="main-content" tabindex="-1" class="wrap about" data-lang={lang}>
    <div class="intro">
      <p class="eyebrow">{t.aboutEyebrow}</p>
      <h1>{t.aboutH1}</h1>
      <p class="lead">{t.aboutLead}</p>
    </div>

    <div class="people">
      {people.map((p) => (
        <article class="person" aria-labelledby={`p-${p.id}`} data-reveal>
          <div class="head">
            {p.photo ? (
              <picture>
                <source srcset={p.photo.replace(/\.jpe?g$/, ".webp")} type="image/webp" />
                <img class={`avatar photo ${p.id}`} src={p.photo} alt={p.name} width="88" height="88" decoding="async" />
              </picture>
            ) : (
              <div class={`avatar monogram ${p.id}`} aria-hidden="true">{p.initials}</div>
            )}
            <div>
              <h2 id={`p-${p.id}`}>{p.name}</h2>
              <p class="role">{p.role[lang]}</p>
              <p class="place">{p.place[lang]}</p>
            </div>
          </div>
          {p.bio[lang].map((para) => <p class="bio">{para}</p>)}
          <ul class="facts">{p.facts[lang].map((f) => <li>{f}</li>)}</ul>
          <p class="count"><strong>{count(p.maker)}</strong> {t.aboutCount.replace("{n} ", "")}</p>
          <div class="actions">
            <a class="btn primary" href={`${homePath[lang]}?maker=${encodeURIComponent(p.maker)}#work`}>{t.aboutSeeWork} <span aria-hidden="true">→</span></a>
            <a class="btn ghost" href={p.site.url} target="_blank" rel="noopener">{t.aboutSite} <span aria-hidden="true">↗</span></a>
            <a class="wa" href={p.contact} data-wa={whatsapp[p.id]} data-text={t.waText.replace("{name}", p.maker)} target="_blank" rel="nofollow noopener" aria-label={t.waAria.replace("{name}", p.maker)}>
              <Fragment set:html={WA_ICON} /> {t.waLabel}
            </a>
          </div>
        </article>
      ))}
    </div>

    <section class="shared" aria-labelledby="shared-title">
      <h2 id="shared-title" data-reveal>{t.aboutShared}</h2>
      <div class="principles">
        {principles.map((pr, i) => (
          <div class="principle" data-reveal>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{pr.title[lang]}</h3>
            <p>{pr.text[lang]}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="next" data-reveal>
      <p class="next-title">{t.aboutNext}</p>
      <div class="actions">
        <a class="btn primary" href={questionnairePath[lang]}>{t.heroCta2} <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href={contactPath[lang]}>{t.navContact}</a>
      </div>
    </div>
  </main>
</SubPage>

<script>
  import { decodeNumber } from "../protect";
  // WhatsApp: build the wa.me link only when a visitor taps (the number is not in the page).
  document.querySelectorAll<HTMLAnchorElement>("a[data-wa]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const text = a.dataset.text ? `?text=${encodeURIComponent(a.dataset.text)}` : "";
      window.open(`https://wa.me/${decodeNumber(a.dataset.wa!)}${text}`, "_blank", "noopener");
    }),
  );
</script>

<style>
  .about { padding-top: 3rem; padding-bottom: 5rem; }
  .eyebrow { margin: 0 0 0.8rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  h1 { margin: 0; max-width: 18ch; font-family: var(--font-fraunces); font-weight: 500; font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.03; letter-spacing: -0.03em; text-wrap: balance; }
  .lead { margin: 1.2rem 0 0; max-width: 44rem; font-size: 1.15rem; line-height: 1.7; color: var(--ink-soft); }

  /* One card per maker. */
  .people { display: grid; gap: 1.5rem; margin-top: 3rem; }
  @media (min-width: 960px) { .people { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  .person {
    display: flex; flex-direction: column; padding: clamp(1.5rem, 4vw, 2.3rem);
    border: 1px solid var(--line); border-radius: 22px; background: var(--surface);
    box-shadow: 0 24px 50px -38px var(--shadow);
  }
  .head { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.4rem; }
  .avatar { flex: none; width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
  /* Without a photo: initials lit like the hero, on night blue with a lamp ring. */
  .monogram {
    display: grid; place-items: center; font-family: var(--font-fraunces); font-size: 2rem; letter-spacing: 0.02em; color: var(--text-hi);
    background: radial-gradient(70% 70% at 35% 25%, rgb(255 178 102 / 0.35), transparent 70%), linear-gradient(160deg, var(--night-2), var(--night));
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--lamp), 0 14px 30px -14px rgb(255 178 102 / 0.8);
  }
  .monogram.julien { background: radial-gradient(70% 70% at 35% 25%, rgb(121 173 255 / 0.4), transparent 70%), linear-gradient(160deg, var(--night-2), var(--night)); box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--blue), 0 14px 30px -14px rgb(121 173 255 / 0.7); }
  .photo { display: block; box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--lamp), 0 14px 30px -14px rgb(255 178 102 / 0.8); }
  .photo.julien { box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--blue), 0 14px 30px -14px rgb(121 173 255 / 0.7); }
  .person h2 { margin: 0; font-family: var(--font-fraunces); font-weight: 500; font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.1; letter-spacing: -0.015em; }
  .role { margin: 0.35rem 0 0; color: var(--ink); font-weight: 500; line-height: 1.4; }
  .place { margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--ink-soft); }
  .bio { margin: 0 0 1rem; font-size: 1.02rem; line-height: 1.7; color: var(--ink-soft); text-wrap: pretty; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.4rem 0 1.4rem; padding: 0; list-style: none; }
  .facts li { padding: 0.35rem 0.8rem; border: 1px solid var(--line); border-radius: 99px; font-size: 0.85rem; color: var(--ink); background: var(--bg); }
  .count { margin: auto 0 1.1rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--ink-soft); }
  .count strong { font-family: var(--font-fraunces); font-size: 1.6rem; font-weight: 500; color: var(--accent); margin-right: 0.2rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; }

  .btn {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; padding: 0 1.2rem; border-radius: 99px;
    font-weight: 600; font-size: 0.93rem; text-decoration: none;
    transition: transform var(--dur-short) var(--ease-hover), border-color var(--dur-micro) var(--ease-hover);
  }
  .btn.primary { color: #1a0f04; background: linear-gradient(180deg, var(--lamp-hot), var(--lamp)); box-shadow: 0 10px 24px -12px rgb(255 178 102 / 0.9), inset 0 1px 0 rgb(255 255 255 / 0.6); }
  .btn.ghost { color: var(--ink); border: 1px solid var(--line); }
  .btn.ghost:hover { border-color: var(--ink-soft); }
  @media (hover: hover) { .btn.primary:hover { transform: translateY(-2px); } }
  .wa {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; padding: 0 1rem; border-radius: 99px;
    border: 1px solid rgb(37 211 102 / 0.5); background: rgb(37 211 102 / 0.08); color: var(--ink); font-size: 0.9rem; font-weight: 600; text-decoration: none;
    transition: background var(--dur-micro) var(--ease-hover), border-color var(--dur-micro) var(--ease-hover);
  }
  .wa :global(svg) { color: #1da851; }
  .wa:hover { background: rgb(37 211 102 / 0.16); border-color: #25d366; }

  /* What we share: four numbered principles. */
  .shared { margin-top: 5rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .shared h2 { margin: 0 0 2rem; font-family: var(--font-fraunces); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.02em; }
  .principles { display: grid; gap: 2rem 3rem; }
  @media (min-width: 720px) { .principles { grid-template-columns: 1fr 1fr; } }
  .principle .num { font-family: var(--font-fraunces); font-style: italic; font-size: 1.6rem; color: var(--accent); }
  .principle h3 { margin: 0.3rem 0 0.5rem; font-size: 1.1rem; font-weight: 600; }
  .principle p { margin: 0; line-height: 1.65; color: var(--ink-soft); }

  .next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 4rem; padding: 1.6rem 1.8rem; border-radius: 20px; border: 1px solid var(--line); background: linear-gradient(120deg, rgb(255 194 125 / 0.16), var(--surface) 55%); }
  .next-title { margin: 0; font-family: var(--font-fraunces); font-size: 1.5rem; }
  @media (prefers-reduced-motion: reduce) { .btn.primary:hover { transform: none; } }
</style>
