---
// The floating "Une question ?" button: bottom right of every page (except the
// contact page and the questionnaire). It opens three ways to reach us. The
// WhatsApp numbers are not in the page: the link is built on tap from the
// encoded value (src/protect.ts), as everywhere else on the site.
import { contactPath, strings, tr, type Lang } from "../i18n";
import { whatsapp } from "../data/business";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const label = tr(lang, { fr: "Une question ?", en: "A question?", it: "Una domanda?" });
const WA = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>';
---

<div class="quick" data-quick>
  <div class="quick-panel" id="quick-panel" role="dialog" aria-label={label} hidden>
    <a class="quick-item" href={contactPath[lang]} data-qwa={whatsapp.antony} data-text={t.waText.replace("{name}", "Antony")} rel="nofollow noopener">
      <Fragment set:html={WA} /><span>{tr(lang, { fr: "WhatsApp · Antony", en: "WhatsApp · Antony", it: "WhatsApp · Antony" })}</span>
    </a>
    <a class="quick-item" href={contactPath[lang]} data-qwa={whatsapp.julien} data-text={t.waText.replace("{name}", "Julien")} rel="nofollow noopener">
      <Fragment set:html={WA} /><span>{tr(lang, { fr: "WhatsApp · Julien", en: "WhatsApp · Julien", it: "WhatsApp · Julien" })}</span>
    </a>
    <a class="quick-item write" href={contactPath[lang]}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16v12H4z M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      <span>{tr(lang, { fr: "Écrire un message", en: "Write a message", it: "Scrivi un messaggio" })}</span>
    </a>
  </div>
  <button type="button" class="quick-button" aria-expanded="false" aria-controls="quick-panel">
    <span class="dot" aria-hidden="true"></span>{label}
  </button>
</div>

<script>
  import { decodeNumber } from "../protect";
  document.querySelectorAll<HTMLElement>("[data-quick]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>(".quick-button")!;
    const panel = root.querySelector<HTMLElement>(".quick-panel")!;
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      if (open) panel.querySelector<HTMLAnchorElement>("a")?.focus();
    };
    button.addEventListener("click", () => setOpen(panel.hidden));
    document.addEventListener("click", (e) => { if (!panel.hidden && !root.contains(e.target as Node)) setOpen(false); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) { setOpen(false); button.focus(); }
    });
    root.querySelectorAll<HTMLAnchorElement>("a[data-qwa]").forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const text = a.dataset.text ? `?text=${encodeURIComponent(a.dataset.text)}` : "";
        window.open(`https://wa.me/${decodeNumber(a.dataset.qwa!)}${text}`, "_blank", "noopener");
        setOpen(false);
      }),
    );
  });
</script>

<style>
  .quick {
    position: fixed; z-index: 90;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem;
    font-family: var(--font-inter), system-ui, sans-serif;
  }
  .quick-button {
    display: inline-flex; align-items: center; gap: 0.55rem; min-height: 48px; padding: 0 1.15rem;
    border: 1px solid rgb(255 194 125 / 0.35); border-radius: 99px; cursor: pointer;
    background: #081227; color: #f6f2ea; font: inherit; font-size: 0.92rem; font-weight: 600;
    box-shadow: 0 14px 32px -12px rgb(8 18 39 / 0.65);
    transition: transform 0.25s cubic-bezier(.2,.7,.2,1), border-color 0.2s;
  }
  .quick-button:hover { border-color: #ffc27d; }
  @media (hover: hover) { .quick-button:hover { transform: translateY(-2px); } }
  .quick-button .dot { width: 8px; height: 8px; border-radius: 50%; background: #ffc27d; box-shadow: 0 0 0 4px rgb(255 194 125 / 0.18); }
  .quick-panel {
    display: flex; flex-direction: column; gap: 0.25rem; min-width: 15rem; padding: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.12); border-radius: 16px; background: #0d1a36; color: #f6f2ea;
    box-shadow: 0 22px 48px -18px rgb(0 0 0 / 0.6);
  }
  .quick-panel[hidden] { display: none; }
  .quick-item {
    display: flex; align-items: center; gap: 0.7rem; min-height: 44px; padding: 0 0.85rem; border-radius: 10px;
    color: inherit; text-decoration: none; font-size: 0.92rem; font-weight: 500;
  }
  .quick-item svg { color: #25d366; flex: none; }
  .quick-item.write svg { color: #ffc27d; }
  .quick-item:hover, .quick-item:focus-visible { background: rgb(255 255 255 / 0.08); }
  @media print { .quick { display: none; } }
  @media (prefers-reduced-motion: reduce) { .quick-button:hover { transform: none; } }
</style>
