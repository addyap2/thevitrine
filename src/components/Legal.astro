---
// Mentions légales / legal notice. Details come from src/data/legal.ts. Any
// required field still empty shows as a visible placeholder and is listed as a
// warning in the build log, until it is filled in.
// The privacy section says there is no audience measurement: update it if
// analytics is ever added (and say which tool, and whether it sets cookies).
import { Font } from "astro:assets";
import Brand from "./Brand.astro";
import Nav from "./Nav.astro";
import "../styles/motion.css";
import "../styles/tokens.css";
import { strings, homePath, legalPath, type Lang } from "../i18n";
import { publishers, director, contactEmail, updated, host, missingFields } from "../data/legal";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "fr" ? "en" : "fr";

const missing = missingFields();
if (missing.length) {
  console.warn(`[legal] Notice incomplete, placeholders shown. Fill in src/data/legal.ts: ${missing.join(", ")}`);
}
const todo = lang === "fr" ? "à compléter" : "to be completed";
const sep = lang === "fr" ? "\u00a0: " : ": ";

const date = new Date(updated).toLocaleDateString(lang === "fr" ? "fr-FR" : "en-GB", { day: "numeric", month: "long", year: "numeric" });
const canonical = new URL(legalPath[lang], Astro.site);
const fr = lang === "fr";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.legalTitle} · The Vitrine</title>
    <meta name="description" content={t.legalDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(legalPath.fr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(legalPath.en, Astro.site)} />
    <meta name="theme-color" content="#081227" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-inter" preload={[{ subset: "latin" }]} />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <Brand href={homePath[lang]} />
        <Nav lang={lang} altHref={legalPath[other]} />
      </div>
    </header>

    <main class="wrap">
      <p class="back"><a href={homePath[lang]}><span aria-hidden="true">←</span> {t.legalBack}</a></p>
      <h1>{t.legalTitle}</h1>
      <p class="updated">{t.legalUpdated} {date}</p>

      <section aria-labelledby="publisher">
        <h2 id="publisher">{fr ? "Éditeurs du site" : "Publishers"}</h2>
        <p>
          {fr
            ? "The Vitrine est un site commun, édité conjointement par :"
            : "The Vitrine is a joint site, published by:"}
        </p>
        <div class="people">
          {publishers.map((p) => (
            <dl class="person">
              <dt class="name">{p.name}</dt>
              <dd>{p.status ? p.status[lang] : <span class="todo">{fr ? "Statut" : "Status"}{sep}{todo}</span>}</dd>
              {p.siret === null ? <dd><span class="todo">SIRET{sep}{todo}</span></dd> : p.siret && <dd>SIRET {p.siret}</dd>}
              {p.extra && <dd>{p.extra[lang]}</dd>}
              <dd>{p.address ?? <span class="todo">{fr ? "Adresse" : "Address"}{sep}{todo}</span>}</dd>
              <dd>{p.email ? <a href={`mailto:${p.email}`}>{p.email}</a> : <span class="todo">{fr ? "E-mail" : "Email"}{sep}{todo}</span>}</dd>
              <dd>{p.phone ? (typeof p.phone === "string" ? <a href={`tel:${p.phone.replace(/\s/g, "")}`}>{p.phone}</a> : (
                <span class="phone-protected">
                  <button type="button" class="show-phone" data-phone={p.phone.protected}>{t.showPhone}</button>
                  <noscript>{t.phoneNoJs} {p.email}</noscript>
                </span>
              )) : <span class="todo">{fr ? "Téléphone" : "Phone"}{sep}{todo}</span>}</dd>
            </dl>
          ))}
        </div>
        <p>
          {fr ? "Directeur de la publication : " : "Publication director: "}<strong>{director}</strong>
        </p>
      </section>

      <section aria-labelledby="host">
        <h2 id="host">{fr ? "Hébergement" : "Hosting"}</h2>
        <p>
          {host.name}<br />
          {fr ? host.address.replace("United States", "États-Unis") : host.address}<br />
          <a href={host.url} rel="noopener" target="_blank">vercel.com</a>
        </p>
      </section>

      <section aria-labelledby="ip">
        <h2 id="ip">{fr ? "Propriété intellectuelle" : "Intellectual property"}</h2>
        <p>
          {fr
            ? "Les textes, la mise en page et les éléments graphiques de ce site appartiennent à Antony Addy et Julien Bourgois. Toute reproduction sans autorisation est interdite."
            : "The text, layout and graphics of this site belong to Antony Addy and Julien Bourgois. They may not be reproduced without permission."}
        </p>
        <p>
          {fr
            ? "Les captures d'écran présentent des sites que nous avons réalisés. Leurs contenus, noms et marques restent la propriété de leurs titulaires respectifs. Pour demander le retrait d'une capture, écrivez-nous à "
            : "The screenshots show sites we have built. Their content, names and trademarks remain the property of their respective owners. To ask for a screenshot to be removed, write to "}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>

      <section aria-labelledby="privacy">
        <h2 id="privacy">{fr ? "Données personnelles et cookies" : "Personal data and cookies"}</h2>
        <p>
          {fr
            ? "Ce site ne propose ni compte, ni formulaire, ni mesure d'audience, et ne contient aucun traceur publicitaire. Les polices de caractères sont servies depuis ce site : aucune donnée n'est transmise à un tiers pendant votre visite."
            : "This site has no accounts, no forms, no audience measurement and no advertising trackers. Fonts are served from this site, so no data is passed to a third party during your visit."}
        </p>
        <p>
          {fr
            ? "Un seul cookie est utilisé : « lang », qui retient la langue que vous avez choisie, pendant un an. Il est strictement nécessaire à ce choix et ne demande donc pas de consentement."
            : "One cookie is used: “lang”, which remembers the language you chose, for one year. It is strictly necessary for that choice, so it does not require consent."}
        </p>
        <p>
          {fr
            ? "Comme tout hébergeur, Vercel traite des données techniques (adresse IP, navigateur, pages demandées) pour acheminer le site et le protéger. Les liens « Prendre contact » mènent vers nos sites respectifs, qui ont leur propre politique de confidentialité."
            : "Like any host, Vercel processes technical data (IP address, browser, pages requested) to deliver the site and keep it secure. The “Get in touch” links lead to our own sites, which have their own privacy policies."}
        </p>
        <p>
          {fr
            ? "Conformément au RGPD, vous pouvez demander l'accès, la rectification ou l'effacement de vos données en écrivant à "
            : "Under the GDPR, you can ask to access, correct or erase your data by writing to "}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
          {fr
            ? " Vous pouvez aussi adresser une réclamation à la CNIL (cnil.fr)."
            : " You can also complain to the French data protection authority, the CNIL (cnil.fr)."}
        </p>
      </section>

      <section aria-labelledby="links">
        <h2 id="links">{fr ? "Liens externes" : "External links"}</h2>
        <p>
          {fr
            ? "Ce site renvoie vers des sites que nous avons réalisés, mais que nous ne gérons pas forcément. Nous ne sommes pas responsables de leur contenu actuel."
            : "This site links to sites we have built but don't necessarily run. We are not responsible for their current content."}
        </p>
      </section>
    </main>

    <footer class="wrap foot">
      <p>The Vitrine · {t.madeBy} Antony Addy {t.and} Julien Bourgois</p>
    </footer>
    <script>
      import { decodeNumber, formatPhone } from "../protect";
      // The number is decoded only when a visitor asks for it (kept away from scraping bots).
      document.querySelectorAll<HTMLButtonElement>("button[data-phone]").forEach((b) =>
        b.addEventListener("click", () => {
          const digits = decodeNumber(b.dataset.phone!);
          const link = document.createElement("a");
          link.href = `tel:+${digits}`;
          link.textContent = formatPhone(digits);
          b.replaceWith(link);
          link.focus();
        }),
      );
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #f6f3ee; --surface: #fffdf9; --ink: #1d1b18; --ink-soft: #5d574f; --line: #e4ded4;
    --accent: #a8431f; --brand: #1f5fbf; --night: #081227; --night-2: #10234d; --lamp: #ffc27d; --blue: #79adff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0a1329; --surface: #101b36; --ink: #f2efe8; --ink-soft: #a7b1ca; --line: #22305a; --accent: #ffb27a; --brand: #8ab6ff; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-inter); -webkit-font-smoothing: antialiased; line-height: 1.65; }
  .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 640px) { .wrap { padding: 0 2rem; } }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .top { background: linear-gradient(180deg, var(--night-2), var(--night)); color-scheme: dark; }
  .top :focus-visible { outline-color: var(--lamp); }
  .bar { display: flex; justify-content: space-between; align-items: center; padding-top: 1.25rem; padding-bottom: 1.25rem; max-width: 46rem; }
  .lang {
    font-size: 0.875rem; font-weight: 500; color: #f6f2ea; text-decoration: none;
    padding: 0.4rem 0.9rem; border: 1px solid rgb(255 255 255 / 0.2); border-radius: 99px;
  }
  .lang:hover { border-color: rgb(255 255 255 / 0.45); }

  main.wrap { padding-top: 2.5rem; padding-bottom: 3rem; }
  .back { margin: 0 0 2rem; font-size: 0.9rem; }
  .back a { color: var(--ink-soft); text-decoration: none; }
  .back a:hover { color: var(--accent); }
  h1 { font-family: var(--font-fraunces); font-weight: 500; font-size: clamp(2.2rem, 6vw, 3.2rem); line-height: 1.05; letter-spacing: -0.025em; margin: 0; }
  .updated { color: var(--ink-soft); font-size: 0.875rem; margin: 0.75rem 0 0; }
  section { margin-top: 2.75rem; }
  h2 { font-family: var(--font-fraunces); font-weight: 500; font-size: 1.45rem; letter-spacing: -0.01em; margin: 0 0 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  p { margin: 0 0 1rem; color: var(--ink-soft); }
  strong { color: var(--ink); font-weight: 600; }
  a { color: var(--brand); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .people { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); margin: 0 0 1.25rem; }
  .person { margin: 0; padding: 1.1rem 1.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .person dt { font-family: var(--font-fraunces); font-weight: 500; font-size: 1.2rem; color: var(--ink); margin-bottom: 0.3rem; }
  .person dd { margin: 0; color: var(--ink-soft); font-size: 0.925rem; overflow-wrap: anywhere; }
  .show-phone {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: transparent;
    color: var(--brand);
    cursor: pointer;
  }
  .show-phone:hover { border-color: var(--brand); }
  .todo { font-style: italic; opacity: 0.75; }
  .foot { padding-top: 1.5rem; padding-bottom: 2.5rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--ink-soft); }
  .foot p { margin: 0; }
</style>
